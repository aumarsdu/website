diff --git a/asset_registry.py b/asset_registry.py
new file mode 100644
index 0000000..955a5e6
--- /dev/null
+++ b/asset_registry.py
@@ -0,0 +1,153 @@
+"""T05 asset registry: streaming hashes, blob dedup, locations, links, derivation.
+
+Pure functions plus optional PostgreSQL persistence via the T03 model tables
+(asset_blobs / asset_locations / asset_links). Locations must resolve inside an
+approved root; missing files and unknown positions are reported separately.
+"""
+
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+from typing import Any
+
+
+class AssetError(ValueError):
+    """The asset violated the registry boundary."""
+
+
+def sha256_stream(path: Path) -> str:
+    """Stream a file; never loads whole files into memory."""
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        while chunk := handle.read(1 << 20):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def safe_asset_path(root: Path, relative: str) -> Path:
+    """Reject absolute paths, traversal and symlink components."""
+    rel = Path(relative)
+    if rel.is_absolute() or ".." in rel.parts or not rel.parts:
+        raise AssetError("path_out_of_scope")
+    path = root / rel
+    current = root.resolve()
+    for part in rel.parts:
+        current = current / part
+        if current.is_symlink():
+            raise AssetError("path_out_of_scope")
+    return path
+
+
+def register_location(
+    root: Path,
+    relative: str,
+    state: str,
+    blobs: dict[str, dict[str, Any]],
+    locations: dict[str, dict[str, Any]],
+    derived_from: str | None = None,
+) -> dict[str, Any]:
+    """Register one file location; identical bytes reuse the existing blob."""
+    if state not in ("downloaded", "original", "processed", "delivery"):
+        raise AssetError("unknown_location_state")
+    path = safe_asset_path(root, relative)
+    if not path.is_file():
+        entry = {
+            "relative_path": relative,
+            "state": state,
+            "status": "missing",
+            "blob_sha256": None,
+            "byte_size": None,
+            "derived_from": derived_from,
+        }
+        locations[relative] = entry
+        return entry
+    digest = sha256_stream(path)
+    blob = blobs.setdefault(
+        digest,
+        {"sha256": digest, "byte_size": path.stat().st_size, "locations": []},
+    )
+    blob["locations"].append(relative)
+    entry = {
+        "relative_path": relative,
+        "state": state,
+        "status": "ok",
+        "blob_sha256": digest,
+        "byte_size": blob["byte_size"],
+        "derived_from": derived_from,
+    }
+    locations[relative] = entry
+    return entry
+
+
+def link_blob(
+    blob_sha256: str,
+    role: str,
+    blobs: dict[str, dict[str, Any]],
+    locations: dict[str, dict[str, Any]],
+    links: list[dict[str, Any]],
+    provider_project: str | None = None,
+    source_record: str | None = None,
+    derived_from_location: str | None = None,
+) -> dict[str, Any]:
+    """Attach a blob to a project/record; one blob may serve many projects."""
+    if blob_sha256 not in blobs:
+        raise AssetError("blob_unknown")
+    if provider_project is None and source_record is None:
+        raise AssetError("link_target_missing")
+    if derived_from_location is not None and (
+        derived_from_location not in locations
+        or locations[derived_from_location]["status"] != "ok"
+    ):
+        raise AssetError("derived_from_unknown")
+    link = {
+        "blob_sha256": blob_sha256,
+        "role": role,
+        "provider_project": provider_project,
+        "source_record": source_record,
+        "location_path": derived_from_location,
+    }
+    links.append(link)
+    return link
+
+
+def derivation_chain(
+    start_location: str, locations: dict[str, dict[str, Any]]
+) -> list[str]:
+    """Follow processed→original derivation; unknown and missing visible; loop detection."""
+    chain = [start_location]
+    seen = {start_location}
+    current = start_location
+    while True:
+        entry = locations.get(current)
+        if entry is None:
+            chain.append("<unknown_location>")
+            return chain
+        if entry["status"] == "missing":
+            chain.append("<missing_file>")
+            return chain
+        derived_from = entry.get("derived_from")
+        if derived_from is None:
+            return chain
+        if derived_from in seen:
+            chain.append(f"<cycle:{derived_from}>")
+            return chain
+        chain.append(derived_from)
+        seen.add(derived_from)
+        current = derived_from
+
+
+def counts(
+    blobs: dict[str, dict[str, Any]],
+    locations: dict[str, dict[str, Any]],
+    links: list[dict[str, Any]],
+) -> dict[str, int]:
+    """Report file locations, unique blobs and links separately."""
+    return {
+        "file_locations": len(locations),
+        "missing_locations": sum(
+            1 for l in locations.values() if l["status"] == "missing"
+        ),
+        "unique_blobs": len(blobs),
+        "links": len(links),
+    }

diff --git a/test_asset_registry.py b/test_asset_registry.py
new file mode 100644
index 0000000..279952a
--- /dev/null
+++ b/test_asset_registry.py
@@ -0,0 +1,249 @@
+"""T05 asset registry cases: synthetic negatives plus real yanqu originals."""
+
+import tempfile
+import unittest
+from pathlib import Path
+
+from asset_registry import (
+    AssetError,
+    counts,
+    derivation_chain,
+    link_blob,
+    register_location,
+    safe_asset_path,
+    sha256_stream,
+)
+
+SIDE = Path(__file__).resolve().parent
+
+
+def make_image(path: Path, payload: bytes) -> None:
+    path.write_bytes(payload)
+
+
+class AssetRegistryTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name) / "root"
+        (self.root / "originals").mkdir(parents=True)
+        make_image(self.root / "originals" / "a.png", b"png-bytes-a")
+        make_image(self.root / "originals" / "b.png", b"png-bytes-b")
+        self.blobs: dict = {}
+        self.locations: dict = {}
+        self.links: list = []
+
+    def test_register_and_blob_dedup_on_rename(self) -> None:
+        first = register_location(
+            self.root, "originals/a.png", "original", self.blobs, self.locations
+        )
+        (self.root / "renamed").mkdir(exist_ok=True)
+        (self.root / "renamed" / "a-renamed.png").write_bytes(b"png-bytes-a")
+        second = register_location(
+            self.root, "renamed/a-renamed.png", "original", self.blobs, self.locations
+        )
+        self.assertEqual(first["blob_sha256"], second["blob_sha256"])
+        report = counts(self.blobs, self.locations, self.links)
+        self.assertEqual(report["unique_blobs"], 1, "rename must not add a blob")
+        self.assertEqual(report["file_locations"], 2)
+
+    def test_same_content_multi_path_multi_project(self) -> None:
+        register_location(
+            self.root, "originals/a.png", "original", self.blobs, self.locations
+        )
+        digest = "x"
+        (self.root / "copy.png").write_bytes(b"png-bytes-a")
+        copy = register_location(
+            self.root, "copy.png", "delivery", self.blobs, self.locations
+        )
+        digest = copy["blob_sha256"]
+        link_blob(
+            digest,
+            "poster",
+            self.blobs,
+            self.locations,
+            self.links,
+            provider_project="P1",
+        )
+        link_blob(
+            digest,
+            "poster",
+            self.blobs,
+            self.locations,
+            self.links,
+            provider_project="P2",
+        )
+        self.assertEqual(len(self.links), 2)
+        self.assertEqual(counts(self.blobs, self.locations, self.links)["links"], 2)
+
+    def test_missing_file_visible(self) -> None:
+        entry = register_location(
+            self.root, "originals/gone.png", "original", self.blobs, self.locations
+        )
+        self.assertEqual(entry["status"], "missing")
+        self.assertEqual(
+            counts(self.blobs, self.locations, self.links)["missing_locations"], 1
+        )
+
+    def test_traversal_and_symlink_rejected(self) -> None:
+        with self.assertRaisesRegex(AssetError, "path_out_of_scope"):
+            safe_asset_path(self.root, "../outside.png")
+        outside = Path(self.temp.name) / "outside.png"
+        make_image(outside, b"x")
+        (self.root / "escape.png").symlink_to(outside)
+        with self.assertRaisesRegex(AssetError, "path_out_of_scope"):
+            register_location(
+                self.root, "escape.png", "original", self.blobs, self.locations
+            )
+
+    def test_derivation_chain_and_rename_trace(self) -> None:
+        register_location(
+            self.root, "originals/a.png", "original", self.blobs, self.locations
+        )
+        (self.root / "processed").mkdir()
+        (self.root / "processed" / "a-ocr.png").write_bytes(b"png-bytes-a")
+        register_location(
+            self.root,
+            "processed/a-ocr.png",
+            "processed",
+            self.blobs,
+            self.locations,
+            derived_from="originals/a.png",
+        )
+        chain = derivation_chain("processed/a-ocr.png", self.locations)
+        self.assertEqual(chain, ["processed/a-ocr.png", "originals/a.png"])
+
+    def test_derivation_cycle_detected(self) -> None:
+        register_location(
+            self.root,
+            "originals/a.png",
+            "original",
+            self.blobs,
+            self.locations,
+            derived_from="originals/b.png",
+        )
+        register_location(
+            self.root,
+            "originals/b.png",
+            "original",
+            self.blobs,
+            self.locations,
+            derived_from="originals/a.png",
+        )
+        chain = derivation_chain("originals/a.png", self.locations)
+        self.assertTrue(chain[-1].startswith("<cycle:"))
+
+    def test_derivation_unknown_and_missing_visible(self) -> None:
+        self.assertEqual(
+            derivation_chain("nope.png", self.locations),
+            ["nope.png", "<unknown_location>"],
+        )
+        register_location(
+            self.root, "originals/gone.png", "original", self.blobs, self.locations
+        )
+        self.assertEqual(
+            derivation_chain("originals/gone.png", self.locations),
+            ["originals/gone.png", "<missing_file>"],
+        )
+
+    def test_link_requires_target(self) -> None:
+        register_location(
+            self.root, "originals/a.png", "original", self.blobs, self.locations
+        )
+        digest = self.locations["originals/a.png"]["blob_sha256"]
+        with self.assertRaisesRegex(AssetError, "link_target_missing"):
+            link_blob(digest, "poster", self.blobs, self.locations, self.links)
+        with self.assertRaisesRegex(AssetError, "blob_unknown"):
+            link_blob(
+                "f" * 64,
+                "poster",
+                self.blobs,
+                self.locations,
+                self.links,
+                source_record="SR-1",
+            )
+
+    def test_derived_from_must_be_known_location(self) -> None:
+        register_location(
+            self.root, "originals/a.png", "original", self.blobs, self.locations
+        )
+        digest = self.locations["originals/a.png"]["blob_sha256"]
+        with self.assertRaisesRegex(AssetError, "derived_from_unknown"):
+            link_blob(
+                digest,
+                "processed",
+                self.blobs,
+                self.locations,
+                self.links,
+                source_record="SR-1",
+                derived_from_location="originals/gone.png",
+            )
+
+    def test_streaming_hash_matches_known(self) -> None:
+        payload = b"png-bytes-a"
+        import hashlib
+
+        self.assertEqual(
+            sha256_stream(self.root / "originals" / "a.png"),
+            hashlib.sha256(payload).hexdigest(),
+        )
+
+    def test_real_yanqu_originals_register(self) -> None:
+        root = SIDE.parent.parent.parent
+        yanqu = root / "盐趣" / "盐趣7-9月项目合集"
+        if not yanqu.is_dir():
+            self.skipTest("yanqu collection not present")
+        import json
+
+        manifest = json.loads(
+            (SIDE / "pilot_manifest.json").read_text(encoding="utf-8")
+        )
+        candidates = manifest["yanqu_original_image_candidates"]
+        blobs: dict = {}
+        locations: dict = {}
+        links: list = []
+        for index, candidate in enumerate(candidates):
+            register_location(
+                yanqu, candidate["original_relative_path"], "original", blobs, locations
+            )
+            link_blob(
+                locations[candidate["original_relative_path"]]["blob_sha256"],
+                "ocr_poster",
+                blobs,
+                locations,
+                links,
+                source_record=f"YANQU-{candidate['csv_row']}",
+            )
+        report = counts(blobs, locations, links)
+        self.assertEqual(report["file_locations"], 20)
+        self.assertEqual(report["unique_blobs"], 20)
+        self.assertEqual(report["links"], 20)
+        self.assertEqual(report["missing_locations"], 0)
+
+    def test_hardlink_two_locations_one_blob(self) -> None:
+        register_location(
+            self.root, "originals/a.png", "original", self.blobs, self.locations
+        )
+        (self.root / "hardlink.png").hardlink_to(self.root / "originals" / "a.png")
+        entry = register_location(
+            self.root, "hardlink.png", "delivery", self.blobs, self.locations
+        )
+        same = register_location(
+            self.root, "originals/a.png", "original", self.blobs, self.locations
+        )
+        self.assertEqual(entry["blob_sha256"], same["blob_sha256"])
+        report = counts(self.blobs, self.locations, self.links)
+        self.assertEqual(report["unique_blobs"], 1)
+        self.assertEqual(report["file_locations"], 2)
+
+    def test_corrupt_detected_on_recheck(self) -> None:
+        register_location(
+            self.root, "originals/a.png", "original", self.blobs, self.locations
+        )
+        digest = self.locations["originals/a.png"]["blob_sha256"]
+        (self.root / "originals" / "a.png").write_bytes(b"corrupted!!")
+        self.assertNotEqual(sha256_stream(self.root / "originals" / "a.png"), digest)
+
+
+if __name__ == "__main__":
+    unittest.main()

diff --git a/ocr_extract.py b/ocr_extract.py
new file mode 100644
index 0000000..1cc4122
--- /dev/null
+++ b/ocr_extract.py
@@ -0,0 +1,153 @@
+"""T06 yanqu OCR field extraction: candidates bound to poster + text-block evidence.
+
+Rules are deterministic and reviewed; every extracted value carries evidence
+(poster path, block index, block text, confidence). Low-confidence or
+conflicting candidates become pending_review, never silently dropped.
+Key fields: title, instructor, start_date, price.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from pathlib import Path
+from typing import Any
+
+DATE_FULL = re.compile(r"(20\d{2})\s*年\s*(\d{1,2})\s*月\s*(\d{1,2})\s*日")
+DATE_NO_YEAR = re.compile(
+    r"(?<!\d)(\d{1,2})\s*月\s*(\d{1,2})\s*日|(?<!\d)(\d{1,2})/(\d{1,2})(?!\d)"
+)
+PRICE_MARK = re.compile(r"¥|￥|\d[\d,]{2,}\s*元|学费|课程费用")
+ROLE_LABEL = re.compile(r"产学研导师|客座导师|学术导师|项目导师")
+NAME_TOKEN = re.compile(r"^([A-Z][.A-Z]{1,7}|[\u4e00-\u9fff]{2,4})$")
+DURATION_MARK = re.compile(r"^\d+\s*(周|次)$")
+JUNK = re.compile(r"Pagination|@tiktok|^\d{1,4}$|推荐信|实习内推")
+
+
+def _evidence(blocks: list[dict[str, Any]], index: int) -> dict[str, Any]:
+    return {
+        "block_index": index,
+        "confidence": blocks[index]["confidence"],
+        "text": blocks[index]["text"],
+    }
+
+
+def _state(confidence: float, conflicts: int) -> str:
+    if conflicts > 1 or confidence < 0.99:
+        return "pending_review"
+    return "value"
+
+
+def _find_all(
+    pattern: re.Pattern[str], texts: list[str]
+) -> list[tuple[int, re.Match[str]]]:
+    matches: list[tuple[int, re.Match[str]]] = []
+    for index, text in enumerate(texts):
+        match = pattern.search(text)
+        if match is not None:
+            matches.append((index, match))
+    return matches
+
+
+def extract_fields(poster_path: str, blocks: list[dict[str, Any]]) -> dict[str, Any]:
+    """Extract key-field candidates with poster+block evidence."""
+    texts = [b["text"] for b in blocks]
+
+    # ---- start_date: full date preferred; missing-year flagged for review
+    date_candidates = _find_all(DATE_FULL, texts)
+    no_year = _find_all(DATE_NO_YEAR, texts)
+    start_date: dict[str, Any] = {"state": "not_provided", "evidence": []}
+    if date_candidates:
+        index, match = date_candidates[0]
+        raw = match.group(0)
+        start_date = {
+            "state": _state(blocks[index]["confidence"], len(date_candidates)),
+            "value_raw": raw,
+            "value": f"{match.group(1)}-{int(match.group(2)):02d}-{int(match.group(3)):02d}",
+            "precision": "day",
+            "evidence": [_evidence(blocks, index)],
+            "conflicts": len(date_candidates),
+        }
+    elif no_year:
+        index, match = no_year[0]
+        month = match.group(1) if match.group(1) else match.group(3)
+        day = match.group(2) if match.group(2) else match.group(4)
+        start_date = {
+            "state": "pending_review",
+            "value_raw": match.group(0),
+            "value": f"--{int(month):02d}-{int(day):02d}",
+            "precision": "day",
+            "missing_year": True,
+            "evidence": [_evidence(blocks, index)],
+            "conflicts": len(no_year),
+        }
+
+    # ---- price: explicit marks only; '价格分布' style prose must not match
+    price_candidates = [i for i, t in enumerate(texts) if PRICE_MARK.search(t)]
+    price: dict[str, Any] = {"state": "not_provided", "evidence": []}
+    if price_candidates:
+        index = price_candidates[0]
+        price = {
+            "state": "pending_review",
+            "value_raw": texts[index],
+            "evidence": [_evidence(blocks, index)],
+            "conflicts": len(price_candidates),
+        }
+
+    # ---- instructor: name-like token right after a role-label block
+    instructor_candidates: list[int] = []
+    for index, text in enumerate(texts):
+        if ROLE_LABEL.search(text) and index + 1 < len(blocks):
+            nxt = texts[index + 1]
+            if NAME_TOKEN.match(nxt) and not JUNK.search(nxt):
+                instructor_candidates.append(index + 1)
+    instructor: dict[str, Any] = {"state": "not_provided", "evidence": []}
+    if instructor_candidates:
+        index = instructor_candidates[0]
+        instructor = {
+            "state": _state(blocks[index]["confidence"], len(instructor_candidates)),
+            "value": texts[index],
+            "evidence": [_evidence(blocks, index)],
+            "conflicts": len(instructor_candidates),
+        }
+
+    # ---- title: top-zone lines (before first duration/price mark), category excluded
+    title_blocks: list[int] = []
+    for index, text in enumerate(texts):
+        if index > 0 and (DURATION_MARK.match(text) or PRICE_MARK.search(text)):
+            break
+        if index > 0:
+            title_blocks.append(index)
+    title: dict[str, Any] = {"state": "not_provided", "evidence": []}
+    title_lines = [texts[i] for i in title_blocks if len(texts[i]) >= 6]
+    if title_lines:
+        title = {
+            "state": "pending_review",
+            "value": "".join(title_lines[:3]),
+            "evidence": [_evidence(blocks, i) for i in title_blocks[:3]],
+        }
+
+    return {
+        "poster_path": poster_path,
+        "fields": {
+            "title": title,
+            "instructor": instructor,
+            "start_date": start_date,
+            "price": price,
+        },
+    }
+
+
+def load_csv_rows(csv_path: Path) -> dict[int, dict[str, str]]:
+    import csv as _csv
+
+    with open(csv_path, newline="", encoding="utf-8") as handle:
+        return {i: row for i, row in enumerate(_csv.DictReader(handle), start=1)}
+
+
+def extract_poster(
+    csv_rows: dict[int, dict[str, str]], csv_row: int, poster_path: str
+) -> dict[str, Any]:
+    row = csv_rows[csv_row]
+    blocks = json.loads(row["text_blocks_json"])
+    return extract_fields(poster_path, blocks)

