+"""T03 migration cases, executed on the isolated candidate PostgreSQL 16 cluster.
+
+The cluster is TCP-loopback only (127.0.0.1:55441); legacy endpoint /tmp:55432
+is never touched. Every test runs against a throwaway database.
+"""
+
+import json
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+
+import pg_candidate
+import run_migrations
+from contract import identity_key
+
+SIDE = Path(__file__).resolve().parent
+MIGRATIONS = SIDE / "migrations"
+LEGACY_FIXTURE = SIDE / "tests" / "legacy_replica.sql"
+
+
+def errdup(exc: Exception) -> str:
+    return str(exc)
+
+
+class MigrationTests(unittest.TestCase):
+    db: str
+
+    @classmethod
+    def setUpClass(cls) -> None:
+        pg_candidate.init_cluster()
+
+    def setUp(self) -> None:
+        self.db = "t03_" + self.id().split(".")[-1]
+        pg_candidate.drop_database(self.db)
+        pg_candidate.create_database(self.db)
+        self.addCleanup(pg_candidate.drop_database, self.db)
+
+    def run_migrations(self, directory: Path | None = None) -> int:
+        return run_migrations.run(
+            self.db, directory or MIGRATIONS, __import__("sys").stdout
+        )
+
+    def query(self, sql: str) -> list[str]:
+        return [
+            line
+            for line in pg_candidate.psql(self.db, sql).stdout.splitlines()
+            if line.strip()
+        ]
+
+    def expect_error(self, sql: str, fragment: str) -> None:
+        with self.assertRaises(pg_candidate.ClusterError) as ctx:
+            pg_candidate.psql(self.db, sql)
+        self.assertIn(fragment, str(ctx.exception))
+
+    def seed_model(self) -> None:
+        self.run_migrations()
+        self.query("INSERT INTO providers (provider_name) VALUES ('集思未来');")
+        self.query(
+            "INSERT INTO sources (source_code, provider_id, namespace) "
+            "VALUES ('jisi_sou_tools', (SELECT provider_id FROM providers "
+            "WHERE provider_name='集思未来'), 'sou_tools');"
+        )
+        src = self.query(
+            "SELECT source_id FROM sources WHERE source_code='jisi_sou_tools';"
+        )[0]
+        self.query(
+            "INSERT INTO source_records (source_id, identity_key) VALUES "
+            f"({src}, '{identity_key('jisi_sou_tools', 'JS-001')}');"
+        )
+        self.query(
+            "INSERT INTO source_records (source_id, identity_key) VALUES "
+            f"({src}, '{identity_key('jisi_sou_tools', 'JS-002')}');"
+        )
+        self.query(
+            "INSERT INTO ingest_batches (batch_id, source_id, manifest_digest, "
+            "contract_version, capture_mode, captured_at, observed_order, coverage, "
+            "adapter_version, mapping_version, hash_version) VALUES "
+            "('b1', " + src + ", 'dig1', '1', 'full', '2026-06-02T07:52:16Z', "
+            "null, 'complete', 'a1', 'm1', 'h1'), "
+            "('b2', " + src + ", 'dig2', '1', 'full', '2026-07-03T09:55:05Z', "
+            "null, 'complete', 'a1', 'm1', 'h1');"
+        )
+        self.query(
+            "INSERT INTO content_payloads (payload_hash, hash_version) VALUES "
+            "('pA', 'h1'), ('pB', 'h1');"
+        )
+        self.query(
+            "INSERT INTO observations (source_record_id, payload_id, batch_id, "
+            "context_key, order_key, evidence_location) "
+            "SELECT r.source_record_id, p.payload_id, 'b1', 'default', "
+            "'2026-06-02T07:52:16Z', 'row:1' "
+            "FROM source_records r, content_payloads p "
+            "WHERE r.identity_key LIKE '%JS-001%' AND p.payload_hash='pA';"
+        )
+        self.query(
+            "INSERT INTO observations (source_record_id, payload_id, batch_id, "
+            "context_key, order_key, evidence_location) "
+            "SELECT r.source_record_id, p.payload_id, 'b2', 'default', "
+            "'2026-07-03T09:55:05Z', 'row:2' "
+            "FROM source_records r, content_payloads p "
+            "WHERE r.identity_key LIKE '%JS-002%' AND p.payload_hash='pB';"
+        )
+
+    def test_empty_database_bootstrap(self) -> None:
+        self.assertEqual(self.run_migrations(), run_migrations.EXIT_OK)
+        versions = self.query("SELECT version FROM schema_migrations ORDER BY version;")
+        self.assertEqual(versions, ["0001", "0002", "0003"])
+        status = self.query(
+            "SELECT legacy_replica_present FROM legacy_bridge_status WHERE bridge='0002';"
+        )
+        self.assertEqual(status, ["f"], "bridge must explicitly record empty bootstrap")
+
+    def test_rerun_is_noop(self) -> None:
+        self.run_migrations()
+        before = self.query(
+            "SELECT version, checksum FROM schema_migrations ORDER BY version;"
+        )
+        self.assertEqual(self.run_migrations(), run_migrations.EXIT_OK)
+        after = self.query(
+            "SELECT version, checksum FROM schema_migrations ORDER BY version;"
+        )
+        self.assertEqual(before, after)
+
+    def test_checksum_conflict_rejected(self) -> None:
+        self.run_migrations()
+        temp = Path(tempfile.mkdtemp())
+        self.addCleanup(shutil.rmtree, temp)
+        for sql in sorted(MIGRATIONS.glob("*.sql")):
+            shutil.copy(sql, temp / sql.name)
+        (temp / "0001_candidate_model.sql").write_text(
+            (MIGRATIONS / "0001_candidate_model.sql").read_text(encoding="utf-8")
+            + "\n-- tampered\n",
+            encoding="utf-8",
+        )
+        code = run_migrations.run(self.db, temp, __import__("sys").stdout)
+        self.assertEqual(code, run_migrations.EXIT_CHECKSUM_CONFLICT)
+
+    def test_legacy_replica_upgrade(self) -> None:
+        pg_candidate.psql_file(self.db, LEGACY_FIXTURE)
+        self.assertEqual(self.run_migrations(), run_migrations.EXIT_OK)
+        counts = self.query(
+            "SELECT migrated_counts::text FROM legacy_bridge_status WHERE bridge='0002';"
+        )[0]
+        data = json.loads(counts)
+        self.assertEqual(
+            data,
+            {
+                "providers": 1,
+                "providers_merged_by_name": 0,
+                "sources": 2,
+                "ingest_batches": 2,
+                "ingest_batches_unmigrated_null_source": 0,
+                "source_records": 3,
+                "observations": 4,
+                "provider_projects": 2,
+                "project_source_links": 3,
+                "offerings": 2,
+            },
+        )
+        mapped = self.query(
+            "SELECT count(*) FROM legacy_id_map WHERE legacy_table='source_project_records';"
+        )[0]
+        self.assertEqual(mapped, "3")
+        aba = self.query(
+            "SELECT count(*) FROM observations o "
+            "JOIN legacy_id_map m ON m.new_table='source_records' "
+            "AND m.new_id::bigint=o.source_record_id "
+            "WHERE m.legacy_id='30000000-0000-0000-0000-000000000001';"
+        )[0]
+        self.assertEqual(aba, "3", "A→B→A must keep three observations")
+        expected_identity = identity_key("jisi_sou_tools", "JS-001")
+        match = self.query(
+            "SELECT count(*) FROM source_records WHERE identity_key="
+            f"'{expected_identity}';"
+        )[0]
+        self.assertEqual(match, "1", "bridge identity must equal contract encoding")
+
+    def test_duplicate_source_identity_rejected(self) -> None:
+        self.seed_model()
+        src = self.query(
+            "SELECT source_id FROM sources WHERE source_code='jisi_sou_tools';"
+        )[0]
+        self.expect_error(
+            "INSERT INTO source_records (source_id, identity_key) VALUES "
+            f"({src}, '{identity_key('jisi_sou_tools', 'JS-001')}');",
+            "duplicate key",
+        )
+
+    def test_illegal_observation_reference_rejected(self) -> None:
+        self.seed_model()
+        self.expect_error(
+            "INSERT INTO observations (source_record_id, payload_id, batch_id, "
+            "evidence_location) VALUES (999999, 1, 'b1', 'row:x');",
+            "violates foreign key",
+        )
+
+    def test_current_pointer_same_record_only(self) -> None:
+        self.seed_model()
+        rec1, rec2, obs1, obs2 = self.query(
+            "SELECT r1.source_record_id, r2.source_record_id, "
+            "o1.observation_id, o2.observation_id "
+            "FROM source_records r1, source_records r2, "
+            "observations o1, observations o2 "
+            "WHERE r1.identity_key LIKE '%JS-001%' AND r2.identity_key LIKE '%JS-002%' "
+            "AND o1.source_record_id=r1.source_record_id "
+            "AND o2.source_record_id=r2.source_record_id;"
+        )[0].split("|")
+        self.assertNotEqual(rec1.strip(), rec2.strip())
+        self.expect_error(
+            "INSERT INTO source_record_current (source_record_id, observation_id) "
+            f"VALUES ({rec1.strip()}, {obs2.strip()});",
+            "violates foreign key",
+        )
+        self.query(
+            "INSERT INTO source_record_current (source_record_id, observation_id) "
+            f"VALUES ({rec1.strip()}, {obs1.strip()});"
+        )
+        count = self.query("SELECT count(*) FROM source_record_current;")[0]
+        self.assertEqual(count, "1")
+
+    def test_batch_immutable(self) -> None:
+        self.seed_model()
+        self.expect_error(
+            "UPDATE ingest_batches SET coverage='partial' WHERE batch_id='b1';",
+            "ingest_batches is immutable",
+        )
+        self.expect_error(
+            "DELETE FROM ingest_batches WHERE batch_id='b1';",
+            "ingest_batches is immutable",
+        )
+
+    def test_offering_field_state_check(self) -> None:
+        self.seed_model()
+        self.query(
+            "INSERT INTO provider_projects (provider_id, native_project_key) "
+            "SELECT provider_id, 'PP-1' FROM providers LIMIT 1;"
+        )
+        self.expect_error(
+            "INSERT INTO offerings (provider_project_id, offering_key, field_state) "
+            "SELECT provider_project_id, 'OFF-X', 'guessed' FROM provider_projects "
+            "WHERE native_project_key='PP-1';",
+            "violates check constraint",
+        )
+        for state in ("value", "explicitly_empty", "not_provided", "extraction_failed"):
+            self.query(
+                "INSERT INTO offerings (provider_project_id, offering_key, field_state) "
+                "SELECT provider_project_id, 'OFF-" + state + "', '" + state + "' "
+                "FROM provider_projects WHERE native_project_key='PP-1';"
+            )
+
+    def test_migration_interrupt_and_recovery(self) -> None:
+        temp = Path(tempfile.mkdtemp())
+        self.addCleanup(shutil.rmtree, temp)
+        for sql in sorted(MIGRATIONS.glob("*.sql")):
+            shutil.copy(sql, temp / sql.name)
+        (temp / "0004_interrupted.sql").write_text(
+            "CREATE TABLE partial_artifact (x int);\n"
+            "INSERT INTO table_that_does_not_exist VALUES (1);\n",
+            encoding="utf-8",
+        )
+        code = run_migrations.run(self.db, temp, __import__("sys").stdout)
+        self.assertEqual(code, run_migrations.EXIT_SQL_ERROR)
+        ledger = self.query("SELECT version FROM schema_migrations ORDER BY version;")
+        self.assertEqual(ledger, ["0001", "0002", "0003"])
+        artifact = self.query("SELECT to_regclass('partial_artifact') IS NOT NULL;")[0]
+        self.assertEqual(artifact, "f", "failed migration must roll back completely")
+        (temp / "0004_interrupted.sql").unlink()
+        self.assertEqual(
+            run_migrations.run(self.db, temp, __import__("sys").stdout),
+            run_migrations.EXIT_OK,
+        )
+        final = self.query("SELECT count(*) FROM schema_migrations;")[0]
+        self.assertEqual(final, "3")
+
+
+if __name__ == "__main__":
+    unittest.main()

diff --git a/schema_model.md b/schema_model.md
new file mode 100644
index 0000000..5cd9dbb
--- /dev/null
+++ b/schema_model.md
@@ -0,0 +1,96 @@
+# T03 候选模型与迁移（candidate v1）
+
+- 状态：候选，待独立迁移评审（G-R）。
+- 目标 PostgreSQL：16.15（Homebrew），候选集群仅 TCP loopback `127.0.0.1:55441`，unix socket 禁用；数据目录 `candidate_pg/data`（带 `.target_ownership.json` 归属标记，`target_guard` 预检通过见 `evidence/target_check_candidate_pg.json`）。旧端点 `/tmp:55432` 永不连接。
+- 契约对应：contract v1 / hash h1（见 `contract.md`）。
+
+## 1. 实体关系（ER，Mermaid）
+
+```mermaid
+erDiagram
+    providers ||--o{ sources : ""
+    sources ||--o{ ingest_batches : ""
+    ingest_batches ||--o{ input_files : ""
+    sources ||--o{ source_records : ""
+    source_records ||--o{ observations : ""
+    content_payloads ||--o{ observations : ""
+    ingest_batches ||--o{ observations : ""
+    source_records ||--o| source_record_current : "同记录指针"
+    observations ||--o| source_record_current : "(observation_id, source_record_id) 复合 FK"
+    providers ||--o{ provider_projects : ""
+    provider_projects ||--o{ project_source_links : ""
+    source_records ||--o{ project_source_links : ""
+    provider_projects ||--o{ offerings : "期次边界"
+    asset_blobs ||--o{ asset_locations : "字节去重/位置分离"
+    asset_blobs ||--o{ asset_links : "一图多项目"
+    asset_locations |o--o{ asset_links : "派生关系"
+    source_records ||--o{ extractions : ""
+    extractions ||--o{ field_evidence : "字段状态四态+证据"
+    source_records ||--o{ conflicts : ""
+    conflicts ||--o{ conflict_members : ""
+    observations ||--o{ conflict_members : ""
+    provider_projects ||--o{ identity_links : "合并/拆分审计"
+```
+
+## 2. 数据字典（关键约束）
+
+| 表 | 关键约束 / 语义 |
+| --- | --- |
+| providers | `provider_name` UNIQUE |
+| sources | `source_code` UNIQUE；`(provider_id, namespace)` UNIQUE —— 集思海外/国内独立 namespace |
+| ingest_batches | `batch_id` PK（同 batch_id 不同 digest 物理不可能：PK 冲突）；`capture_mode/coverage` CHECK 枚举；`observed_order` NULL=unknown；触发器 `batch_immutable` 拒绝 UPDATE/DELETE（批次描述不可变） |
+| input_files | `(batch_id, relative_path)` UNIQUE |
+| source_records | `(source_id, identity_key)` UNIQUE 来源键唯一且非空；`identity_status` confirmed/candidate |
+| content_payloads | `(payload_hash, hash_version)` UNIQUE |
+| observations | `(batch_id, source_record_id, context_key, payload_id)` UNIQUE 幂等观察键；`order_key` NULL=unknown，ISO-8601 UTC 文本；`(observation_id, source_record_id)` UNIQUE 供同记录指针 FK |
+| source_record_current | 复合 FK `(observation_id, source_record_id) → observations` —— 当前指针不能跨记录；`status` ok/conflict/unresolved |
+| provider_projects | `(provider_id, native_project_key)` UNIQUE |
+| project_source_links | `link_basis` native_id/confirmed/candidate；未确认关系不自动融合 |
+| offerings | `(provider_project_id, offering_key)` UNIQUE 期次；日期原文+精度（day/month/year/unknown）；金额 numeric(14,2) 与原文并存；`field_state` 四态 |
+| asset_blobs/locations/links | 字节 sha256 去重、位置路径 UNIQUE、业务引用与派生关系分离；一 blob 可多 link |
+| extractions / field_evidence | 解析版本；字段原值/规范值/四态/置信度/证据位置/复核状态 |
+| manual_overrides（entity_kind, entity_id 为多态引用，DB 级无 FK，非法实体引用由 T09 应用层拒绝并计入 failed）| 人工覆盖层：实体、字段、旧/新值、依据版本、理由、作者、`reverted_by` 可撤销审计 |
+| conflicts / conflict_members | 同序冲突成员全部保留 |
+| quality_issues / identity_links | P0/P1/P2 质量队列；merge/split 决定审计 |
+| schema_migrations | 版本台账（version PK, checksum, applied_at） |
+| legacy_id_map / legacy_bridge_status | 旧 ID 映射与桥接对账状态 |
+
+## 3. 迁移序列
+
+| 版本 | 文件 | 内容 |
+| --- | --- | --- |
+| 0001 | `migrations/0001_candidate_model.sql` | 候选模型 v1 全部表、约束、batch 不可变触发器 |
+| 0002 | `migrations/0002_legacy_replica_bridge.sql` | 显式创建 pgcrypto；`legacy_replica` 代表性旧 schema 桥接（无则显式记录 no_legacy_replica_present）；行数对账守卫，不静默丢行 |
+
+- 执行器：`run_migrations.py --database <db> --dry-run`（只读：列出 pending/applied，不写库）与 `--apply`（真正应用）二选一必填；默认迁移目录为脚本旁 `migrations/`。每个迁移与其台账行同一事务；已应用且 checksum 相同 → skip；checksum 不一致 → exit 2（拒绝静默跳过不兼容变更）；SQL 失败 → 整体回滚，台账不动（可恢复检查点=上一已提交版本）。
+- 桥接对账（0002）：八类实体行数逐表对账，RAISE 即整体回滚；同名 provider 合并数与 NULL source 批次数显式计入 legacy_bridge_status，不静默丢行。
+- 重跑幂等：重复执行 exit 0 且台账不变（`test_rerun_is_noop`）。
+
+## 4. 旧字段保留/转换/弃用（0002 映射）
+
+| 旧实体 → 新表 | 转换 | 弃用/保留说明 |
+| --- | --- | --- |
+| providers → providers | name 即身份；risk_level/authorization 等列不迁移（权限策略不在首期范围） | 保留于 legacy_replica 只读 |
+| sources → sources | source_code=code；provider 由 canonical_projects 关联解析；namespace=旧 code | base_url 等列弃用（记录于 legacy_replica） |
+| ingest_batches → ingest_batches | batch_id=batch_code；manifest_digest=sha256(id+stats_json)（pgcrypto）；captured_at=started_at；coverage=unknown、observed_order=NULL（诚实未知）；contract/adapter/mapping/hash_version 标 'legacy'/'legacy-bridge' | stats_json/error_json 保留旧表 |
+| source_project_records → source_records | identity_key=contract 编码（`{"native_id":key,"source":code}`，与 contract.py 一致，测试断言） | latest_* 列弃用（投影由 T10 重建） |
+| source_project_record_versions → content_payloads + observations | raw_hash→payload_hash(hash_version='legacy')；crawled_at→order_key（UTC ISO 文本）；source_url→evidence_location；context='legacy' | raw_json 冗余正文不迁移（证据定位保留）；A→B→A 三版本全部保留 |
+| canonical_projects → provider_projects | native_project_key=旧 uuid；display_title=title | status/readiness 枚举弃用（质量状态走 quality_issues） |
+| project_source_links → project_source_links | basis='confirmed' | — |
+| project_offerings → offerings | start_date_text+精度（有 date→day，否则 unknown）；price_amount+price_raw 并存；双空→not_provided | staleness_status 弃用 |
+
+## 5. 初始化与恢复说明
+
+```bash
+# 初始化（幂等）：初始化数据目录并启动隔离集群
+python3 -B pg_candidate.py init
+# 建候选库并迁移（示例库名 candidate_main，实际 pilot 库名在 T09 冻结）
+python3 -B run_migrations.py --database candidate_main --dry-run  # 只读预览
+python3 -B run_migrations.py --database candidate_main --apply      # 真正应用
+# 停止 / 销毁（销毁仅作用于 candidate_pg/ 内数据目录）
+python3 -B pg_candidate.py stop
+python3 -B pg_candidate.py destroy
+```
+
+- 恢复检查点：schema_migrations 台账即迁移检查点；任何失败后重跑自动从最后提交版本继续，无需手工清理（失败事务整体回滚）。
+- 集群数据目录属于候选目标 `candidate_pg`（target_guard 归属标记 T03）；T12 备份恢复演练在该候选库执行。

diff --git a/migrations/0001_candidate_model.sql b/migrations/0001_candidate_model.sql
new file mode 100644
index 0000000..1a63cf0
--- /dev/null
+++ b/migrations/0001_candidate_model.sql
@@ -0,0 +1,227 @@
+-- 0001_candidate_model.sql — T03 candidate model v1 (contract v1 / hash h1)
+-- Checked against spec §3.1/§3.3; no global DO NOTHING; explicit columns only.
+
+CREATE TABLE schema_migrations (
+    version text PRIMARY KEY,
+    checksum text NOT NULL,
+    applied_at timestamptz NOT NULL DEFAULT now()
+);
+
+CREATE TABLE providers (
+    provider_id bigserial PRIMARY KEY,
+    provider_name text NOT NULL UNIQUE
+);
+
+CREATE TABLE sources (
+    source_id bigserial PRIMARY KEY,
+    source_code text NOT NULL UNIQUE,
+    provider_id bigint NOT NULL REFERENCES providers,
+    namespace text NOT NULL,
+    UNIQUE (provider_id, namespace)
+);
+
+CREATE TABLE ingest_batches (
+    batch_id text PRIMARY KEY,
+    source_id bigint NOT NULL REFERENCES sources,
+    manifest_digest text NOT NULL,
+    contract_version text NOT NULL,
+    capture_mode text NOT NULL CHECK (capture_mode IN ('full','incremental','archive','ocr')),
+    captured_at timestamptz NOT NULL,
+    observed_order text,
+    coverage text NOT NULL CHECK (coverage IN ('complete','partial','unknown')),
+    adapter_version text NOT NULL,
+    mapping_version text NOT NULL,
+    hash_version text NOT NULL
+);
+
+CREATE FUNCTION reject_batch_mutation() RETURNS trigger AS $$
+BEGIN
+    RAISE EXCEPTION 'ingest_batches is immutable (batch_id %)', OLD.batch_id;
+END;
+$$ LANGUAGE plpgsql;
+
+CREATE TRIGGER batch_immutable
+    BEFORE UPDATE OR DELETE ON ingest_batches
+    FOR EACH ROW EXECUTE FUNCTION reject_batch_mutation();
+
+CREATE TABLE input_files (
+    input_file_id bigserial PRIMARY KEY,
+    batch_id text NOT NULL REFERENCES ingest_batches,
+    relative_path text NOT NULL,
+    sha256 text NOT NULL,
+    byte_size bigint NOT NULL,
+    row_count bigint NOT NULL,
+    format text NOT NULL,
+    role text NOT NULL,
+    UNIQUE (batch_id, relative_path)
+);
+
+CREATE TABLE source_records (
+    source_record_id bigserial PRIMARY KEY,
+    source_id bigint NOT NULL REFERENCES sources,
+    identity_key text NOT NULL,
+    identity_status text NOT NULL DEFAULT 'confirmed'
+        CHECK (identity_status IN ('confirmed','candidate')),
+    UNIQUE (source_id, identity_key)
+);
+
+CREATE TABLE content_payloads (
+    payload_id bigserial PRIMARY KEY,
+    payload_hash text NOT NULL,
+    hash_version text NOT NULL,
+    UNIQUE (payload_hash, hash_version)
+);
+
+CREATE TABLE observations (
+    observation_id bigserial PRIMARY KEY,
+    source_record_id bigint NOT NULL REFERENCES source_records,
+    payload_id bigint NOT NULL REFERENCES content_payloads,
+    batch_id text NOT NULL REFERENCES ingest_batches,
+    context_key text NOT NULL DEFAULT 'default',
+    order_key text,
+    evidence_location text NOT NULL,
+    UNIQUE (batch_id, source_record_id, context_key, payload_id),
+    UNIQUE (observation_id, source_record_id)
+);
+
+CREATE INDEX idx_observations_record_order
+    ON observations (source_record_id, order_key);
+
+CREATE TABLE source_record_current (
+    source_record_id bigint PRIMARY KEY REFERENCES source_records,
+    observation_id bigint NOT NULL,
+    status text NOT NULL DEFAULT 'ok' CHECK (status IN ('ok','conflict','unresolved')),
+    FOREIGN KEY (observation_id, source_record_id)
+        REFERENCES observations (observation_id, source_record_id)
+);
+
+CREATE TABLE provider_projects (
+    provider_project_id bigserial PRIMARY KEY,
+    provider_id bigint NOT NULL REFERENCES providers,
+    native_project_key text NOT NULL,
+    display_title text,
+    UNIQUE (provider_id, native_project_key)
+);
+
+CREATE TABLE project_source_links (
+    project_source_link_id bigserial PRIMARY KEY,
+    provider_project_id bigint NOT NULL REFERENCES provider_projects,
+    source_record_id bigint NOT NULL REFERENCES source_records,
+    link_basis text NOT NULL CHECK (link_basis IN ('native_id','confirmed','candidate')),
+    UNIQUE (provider_project_id, source_record_id)
+);
+
+CREATE TABLE offerings (
+    offering_id bigserial PRIMARY KEY,
+    provider_project_id bigint NOT NULL REFERENCES provider_projects,
+    offering_key text NOT NULL,
+    start_date_raw text,
+    start_precision text CHECK (start_precision IN ('day','month','year','unknown')),
+    duration_raw text,
+    price_amount numeric(14,2),
+    price_raw text,
+    currency text,
+    enrollment_status_raw text,
+    field_state text NOT NULL
+        CHECK (field_state IN ('value','explicitly_empty','not_provided','extraction_failed')),
+    UNIQUE (provider_project_id, offering_key)
+);
+
+CREATE TABLE asset_blobs (
+    blob_id bigserial PRIMARY KEY,
+    sha256 text NOT NULL UNIQUE,
+    byte_size bigint NOT NULL
+);
+
+CREATE TABLE asset_locations (
+    location_id bigserial PRIMARY KEY,
+    blob_id bigint NOT NULL REFERENCES asset_blobs,
+    relative_path text NOT NULL UNIQUE,
+    state text NOT NULL CHECK (state IN ('downloaded','original','processed','delivery'))
+);
+
+CREATE TABLE asset_links (
+    asset_link_id bigserial PRIMARY KEY,
+    blob_id bigint NOT NULL REFERENCES asset_blobs,
+    provider_project_id bigint REFERENCES provider_projects,
+    source_record_id bigint REFERENCES source_records,
+    derived_from_location_id bigint REFERENCES asset_locations,
+    role text NOT NULL,
+    CHECK (provider_project_id IS NOT NULL OR source_record_id IS NOT NULL)
+);
+
+CREATE TABLE extractions (
+    extraction_id bigserial PRIMARY KEY,
+    source_record_id bigint NOT NULL REFERENCES source_records,
+    extraction_version text NOT NULL,
+    UNIQUE (source_record_id, extraction_version)
+);
+
+CREATE TABLE field_evidence (
+    field_evidence_id bigserial PRIMARY KEY,
+    extraction_id bigint NOT NULL REFERENCES extractions,
+    field_name text NOT NULL,
+    raw_value text,
+    normalized_value text,
+    field_state text NOT NULL
+        CHECK (field_state IN ('value','explicitly_empty','not_provided','extraction_failed')),
+    confidence numeric(6,5),
+    evidence_location text NOT NULL,
+    review_status text NOT NULL DEFAULT 'pending'
+        CHECK (review_status IN ('pending','confirmed','rejected')),
+    UNIQUE (extraction_id, field_name)
+);
+
+CREATE TABLE manual_overrides (
+    override_id bigserial PRIMARY KEY,
+    entity_kind text NOT NULL CHECK (entity_kind IN ('source_record','provider_project','offering')),
+    entity_id bigint NOT NULL,
+    field_name text NOT NULL,
+    old_value text,
+    new_value text NOT NULL,
+    basis_version text NOT NULL,
+    reason text NOT NULL,
+    author text NOT NULL,
+    created_at timestamptz NOT NULL DEFAULT now(),
+    reverted_by bigint REFERENCES manual_overrides
+);
+
+CREATE TABLE conflicts (
+    conflict_id bigserial PRIMARY KEY,
+    source_record_id bigint NOT NULL REFERENCES source_records,
+    order_key text NOT NULL,
+    created_at timestamptz NOT NULL DEFAULT now()
+);
+
+CREATE TABLE conflict_members (
+    conflict_id bigint NOT NULL REFERENCES conflicts,
+    observation_id bigint NOT NULL REFERENCES observations,
+    UNIQUE (conflict_id, observation_id)
+);
+
+CREATE TABLE quality_issues (
+    issue_id bigserial PRIMARY KEY,
+    entity_kind text NOT NULL,
+    entity_id bigint NOT NULL,
+    severity text NOT NULL CHECK (severity IN ('P0','P1','P2')),
+    description text NOT NULL,
+    status text NOT NULL DEFAULT 'open' CHECK (status IN ('open','resolved','wontfix'))
+);
+
+CREATE TABLE identity_links (
+    identity_link_id bigserial PRIMARY KEY,
+    action text NOT NULL CHECK (action IN ('merge','split')),
+    from_provider_project_id bigint REFERENCES provider_projects,
+    to_provider_project_id bigint REFERENCES provider_projects,
+    basis text NOT NULL,
+    author text NOT NULL,
+    created_at timestamptz NOT NULL DEFAULT now()
+);
+
+CREATE TABLE legacy_id_map (
+    legacy_table text NOT NULL,
+    legacy_id text NOT NULL,
+    new_table text NOT NULL,
+    new_id text NOT NULL,
+    PRIMARY KEY (legacy_table, legacy_id, new_table)
+);

diff --git a/migrations/0002_legacy_replica_bridge.sql b/migrations/0002_legacy_replica_bridge.sql
new file mode 100644
index 0000000..e3be87c
--- /dev/null
+++ b/migrations/0002_legacy_replica_bridge.sql
@@ -0,0 +1,225 @@
+-- 0002_legacy_replica_bridge.sql — migrate representative legacy schema (legacy_replica)
+-- into the candidate model. Explicit column mapping only; no global DO NOTHING.
+-- Records what it did in legacy_bridge_status; maps every legacy row in legacy_id_map.
+-- Requires the pgcrypto contrib extension for the legacy manifest digest (created
+-- explicitly here; a cluster without contrib fails loudly at this statement).
+
+CREATE EXTENSION IF NOT EXISTS pgcrypto;
+
+CREATE TABLE legacy_bridge_status (
+    bridge text PRIMARY KEY,
+    legacy_replica_present boolean NOT NULL,
+    migrated_counts jsonb NOT NULL,
+    applied_at timestamptz NOT NULL DEFAULT now()
+);
+
+DO $$
+DECLARE
+    present boolean;
+    v_providers bigint;
+    v_sources bigint;
+    v_batches bigint;
+    v_records bigint;
+    v_versions bigint;
+    v_projects bigint;
+    v_links bigint;
+    v_offerings bigint;
+    v_provider_rows_merged bigint;
+    v_null_source_batches bigint;
+BEGIN
+    present := to_regnamespace('legacy_replica') IS NOT NULL
+        AND to_regclass('legacy_replica.providers') IS NOT NULL;
+    IF NOT present THEN
+        INSERT INTO legacy_bridge_status (bridge, legacy_replica_present, migrated_counts)
+        VALUES ('0002', false, '{"status": "no_legacy_replica_present"}'::jsonb);
+        RETURN;
+    END IF;
+
+    INSERT INTO providers (provider_name)
+    SELECT DISTINCT ON (name) name FROM legacy_replica.providers ORDER BY name, id;
+    GET DIAGNOSTICS v_providers = ROW_COUNT;
+
+    INSERT INTO legacy_id_map (legacy_table, legacy_id, new_table, new_id)
+    SELECT 'providers', p.id::text, 'providers', n.provider_id::text
+    FROM legacy_replica.providers p
+    JOIN providers n ON n.provider_name = p.name
+    ON CONFLICT DO NOTHING;
+
+    -- explicit, non-silent accounting for rows that cannot map 1:1
+    v_provider_rows_merged := (SELECT count(*) FROM legacy_replica.providers)
+        - v_providers;
+    v_null_source_batches := (SELECT count(*) FROM legacy_replica.ingest_batches
+        WHERE source_id IS NULL);
+
+    -- legacy sources carry no provider FK; the association exists through
+    -- canonical_projects → source_project_records, resolved here per source.
+    -- namespace = legacy source code keeps entries distinct under one provider.
+    INSERT INTO sources (source_code, provider_id, namespace)
+    SELECT s.code, pm.new_id::bigint, s.code
+    FROM legacy_replica.sources s
+    JOIN legacy_id_map pm ON pm.legacy_table = 'providers'
+        AND pm.legacy_id = (
+            SELECT cp.provider_id::text
+            FROM legacy_replica.canonical_projects cp
+            JOIN legacy_replica.source_project_records r
+              ON r.id = cp.primary_source_record_id
+            WHERE r.source_id = s.id
+            LIMIT 1);
+    GET DIAGNOSTICS v_sources = ROW_COUNT;
+
+    INSERT INTO legacy_id_map (legacy_table, legacy_id, new_table, new_id)
+    SELECT 'sources', s.id::text, 'sources', n.source_id::text
+    FROM legacy_replica.sources s
+    JOIN sources n ON n.source_code = s.code
+    ON CONFLICT DO NOTHING;
+
+    INSERT INTO ingest_batches (batch_id, source_id, manifest_digest, contract_version,
+                                capture_mode, captured_at, observed_order, coverage,
+                                adapter_version, mapping_version, hash_version)
+    SELECT b.batch_code,
+           sm.new_id::bigint,
+           encode(digest(b.id::text || b.stats_json::text, 'sha256'), 'hex'),
+           'legacy-bridge',
+           'full',
+           COALESCE(b.started_at, b.created_at, now()),
+           NULL,
+           'unknown',
+           'legacy',
+           'legacy',
+           'legacy'
+    FROM legacy_replica.ingest_batches b
+    JOIN legacy_id_map sm
+      ON sm.legacy_table = 'sources' AND sm.legacy_id = b.source_id::text;
+    GET DIAGNOSTICS v_batches = ROW_COUNT;
+
+    -- batches without a legacy source cannot be attributed and are NEVER
+    -- silently dropped: they are counted and fail reconciliation when absent
+    -- from the explicit counter below.
+    IF v_batches + v_null_source_batches
+        <> (SELECT count(*) FROM legacy_replica.ingest_batches) THEN
+        RAISE EXCEPTION 'bridge reconciliation failed: ingest_batches % migrated, % null-source, % total',
+            v_batches, v_null_source_batches,
+            (SELECT count(*) FROM legacy_replica.ingest_batches);
+    END IF;
+
+    INSERT INTO legacy_id_map (legacy_table, legacy_id, new_table, new_id)
+    SELECT 'ingest_batches', b.id::text, 'ingest_batches', n.batch_id
+    FROM legacy_replica.ingest_batches b
+    JOIN ingest_batches n ON n.batch_id = b.batch_code
+    ON CONFLICT DO NOTHING;
+
+    INSERT INTO source_records (source_id, identity_key, identity_status)
+    SELECT sm.new_id::bigint,
+           '{"native_id":' || to_jsonb(r.source_record_key)::text
+             || ',"source":' || to_jsonb((SELECT code FROM legacy_replica.sources
+                                          WHERE id = r.source_id))::text || '}',
+           'confirmed'
+    FROM legacy_replica.source_project_records r
+    JOIN legacy_id_map sm
+      ON sm.legacy_table = 'sources' AND sm.legacy_id = r.source_id::text;
+    GET DIAGNOSTICS v_records = ROW_COUNT;
+
+    INSERT INTO legacy_id_map (legacy_table, legacy_id, new_table, new_id)
+    SELECT 'source_project_records', r.id::text, 'source_records', n.source_record_id::text
+    FROM legacy_replica.source_project_records r
+    JOIN source_records n
+      ON n.identity_key = '{"native_id":' || to_jsonb(r.source_record_key)::text
+           || ',"source":' || to_jsonb((SELECT code FROM legacy_replica.sources
+                                        WHERE id = r.source_id))::text || '}'
+    ON CONFLICT DO NOTHING;
+
+    INSERT INTO content_payloads (payload_hash, hash_version)
+    SELECT DISTINCT v.raw_hash, 'legacy'
+    FROM legacy_replica.source_project_record_versions v;
+
+    INSERT INTO observations (source_record_id, payload_id, batch_id, context_key,
+                              order_key, evidence_location)
+    SELECT rm.new_id::bigint,
+           c.payload_id,
+           bm.new_id,
+           'legacy',
+           CASE WHEN v.crawled_at IS NULL THEN NULL
+                ELSE to_char(v.crawled_at AT TIME ZONE 'UTC',
+                             'YYYY-MM-DD"T"HH24:MI:SS.US"Z"') END,
+           COALESCE(v.source_url, 'legacy:' || v.id::text)
+    FROM legacy_replica.source_project_record_versions v
+    JOIN legacy_id_map rm ON rm.legacy_table = 'source_project_records'
+        AND rm.legacy_id = v.source_project_record_id::text
+    JOIN legacy_id_map bm ON bm.legacy_table = 'ingest_batches'
+        AND bm.legacy_id = v.ingest_batch_id::text
+    JOIN content_payloads c ON c.payload_hash = v.raw_hash AND c.hash_version = 'legacy';
+    GET DIAGNOSTICS v_versions = ROW_COUNT;
+
+    INSERT INTO provider_projects (provider_id, native_project_key, display_title)
+    SELECT pm.new_id::bigint, cp.id::text, cp.title
+    FROM legacy_replica.canonical_projects cp
+    JOIN legacy_id_map pm ON pm.legacy_table = 'providers'
+        AND pm.legacy_id = cp.provider_id::text;
+    GET DIAGNOSTICS v_projects = ROW_COUNT;
+
+    INSERT INTO legacy_id_map (legacy_table, legacy_id, new_table, new_id)
+    SELECT 'canonical_projects', cp.id::text, 'provider_projects', n.provider_project_id::text
+    FROM legacy_replica.canonical_projects cp
+    JOIN provider_projects n ON n.native_project_key = cp.id::text
+    ON CONFLICT DO NOTHING;
+
+    INSERT INTO project_source_links (provider_project_id, source_record_id, link_basis)
+    SELECT ppm.new_id::bigint, srm.new_id::bigint, 'confirmed'
+    FROM legacy_replica.project_source_links l
+    JOIN legacy_id_map ppm ON ppm.legacy_table = 'canonical_projects'
+        AND ppm.legacy_id = l.canonical_project_id::text
+    JOIN legacy_id_map srm ON srm.legacy_table = 'source_project_records'
+        AND srm.legacy_id = l.source_project_record_id::text;
+    GET DIAGNOSTICS v_links = ROW_COUNT;
+
+    INSERT INTO offerings (provider_project_id, offering_key, start_date_raw, start_precision,
+                           duration_raw, price_amount, price_raw, currency,
+                           enrollment_status_raw, field_state)
+    SELECT ppm.new_id::bigint,
+           COALESCE(o.offering_code, o.id::text),
+           o.start_date_text,
+           CASE WHEN o.start_date IS NOT NULL THEN 'day' ELSE 'unknown' END,
+           o.duration,
+           o.price_amount,
+           o.price_amount::text,
+           o.price_currency,
+           NULL,
+           CASE WHEN o.price_amount IS NULL AND o.start_date_text IS NULL
+                THEN 'not_provided' ELSE 'value' END
+    FROM legacy_replica.project_offerings o
+    JOIN legacy_id_map ppm ON ppm.legacy_table = 'canonical_projects'
+        AND ppm.legacy_id = o.canonical_project_id::text;
+    GET DIAGNOSTICS v_offerings = ROW_COUNT;
+
+    -- reconciliation: the bridge must not silently drop any legacy row
+    IF v_sources <> (SELECT count(*) FROM legacy_replica.sources) THEN
+        RAISE EXCEPTION 'bridge reconciliation failed: sources % of % migrated',
+            v_sources, (SELECT count(*) FROM legacy_replica.sources);
+    END IF;
+    IF v_records <> (SELECT count(*) FROM legacy_replica.source_project_records) THEN
+        RAISE EXCEPTION 'bridge reconciliation failed: source_records % of % migrated',
+            v_records, (SELECT count(*) FROM legacy_replica.source_project_records);
+    END IF;
+    IF v_versions <> (SELECT count(*) FROM legacy_replica.source_project_record_versions) THEN
+        RAISE EXCEPTION 'bridge reconciliation failed: versions % of % migrated',
+            v_versions, (SELECT count(*) FROM legacy_replica.source_project_record_versions);
+    END IF;
+    IF v_links <> (SELECT count(*) FROM legacy_replica.project_source_links) THEN
+        RAISE EXCEPTION 'bridge reconciliation failed: links % of % migrated',
+            v_links, (SELECT count(*) FROM legacy_replica.project_source_links);
+    END IF;
+    IF v_offerings <> (SELECT count(*) FROM legacy_replica.project_offerings) THEN
+        RAISE EXCEPTION 'bridge reconciliation failed: offerings % of % migrated',
+            v_offerings, (SELECT count(*) FROM legacy_replica.project_offerings);
+    END IF;
+
+    INSERT INTO legacy_bridge_status (bridge, legacy_replica_present, migrated_counts)
+    VALUES ('0002', true, jsonb_build_object(
+        'providers', v_providers, 'providers_merged_by_name', v_provider_rows_merged,
+        'sources', v_sources, 'ingest_batches', v_batches,
+        'ingest_batches_unmigrated_null_source', v_null_source_batches,
+        'source_records', v_records, 'observations', v_versions,
+        'provider_projects', v_projects, 'project_source_links', v_links,
+        'offerings', v_offerings));
+END;
+$$;

diff --git a/migrations/0003_content_payload_bodies.sql b/migrations/0003_content_payload_bodies.sql
new file mode 100644
index 0000000..31d13a7
--- /dev/null
+++ b/migrations/0003_content_payload_bodies.sql
@@ -0,0 +1,9 @@
+-- 0003_content_payload_bodies.sql — T10: sanitized business bodies for payloads
+-- The hash-only payload table cannot render projections; the sanitized body
+-- (whitelisted business fields + field states) is stored alongside its digest.
+
+CREATE TABLE content_payload_bodies (
+    payload_id bigint PRIMARY KEY REFERENCES content_payloads,
+    business jsonb NOT NULL,
+    field_states jsonb NOT NULL
+);

diff --git a/tests/legacy_replica.sql b/tests/legacy_replica.sql
new file mode 100644
index 0000000..7fb1ed1
--- /dev/null
+++ b/tests/legacy_replica.sql
@@ -0,0 +1,133 @@
+-- tests/legacy_replica.sql — representative copy of the pre-2026-09-08 schema (subset)
+-- Loads into schema legacy_replica so the new model (public) never collides.
+-- Documented deviations from db/research_db/schema.sql: users FK columns kept as plain
+-- uuid columns (no users table in the representative subset); enums recreated locally.
+
+CREATE SCHEMA IF NOT EXISTS legacy_replica;
+
+CREATE TYPE legacy_replica.risk_level AS ENUM ('low','medium','high');
+CREATE TYPE legacy_replica.project_status AS ENUM ('imported','searchable','published');
+CREATE TYPE legacy_replica.readiness_level AS ENUM ('raw','cleaned','searchable');
+CREATE TYPE legacy_replica.staleness_status AS ENUM ('fresh','stale','unknown');
+
+CREATE TABLE legacy_replica.providers (
+  id uuid PRIMARY KEY,
+  code text UNIQUE,
+  name text NOT NULL,
+  provider_type text,
+  cooperation_status text NOT NULL DEFAULT 'candidate',
+  risk_level legacy_replica.risk_level DEFAULT 'medium',
+  is_active boolean DEFAULT true,
+  created_at timestamptz DEFAULT now()
+);
+
+CREATE TABLE legacy_replica.sources (
+  id uuid PRIMARY KEY,
+  code text UNIQUE NOT NULL,
+  name text NOT NULL,
+  base_url text,
+  created_at timestamptz DEFAULT now()
+);
+
+CREATE TABLE legacy_replica.ingest_batches (
+  id uuid PRIMARY KEY,
+  source_id uuid REFERENCES legacy_replica.sources(id),
+  batch_code text UNIQUE,
+  input_path text NOT NULL,
+  input_format text,
+  started_at timestamptz,
+  finished_at timestamptz,
+  stats_json jsonb NOT NULL DEFAULT '{}',
+  created_at timestamptz DEFAULT now()
+);
+
+CREATE TABLE legacy_replica.source_project_records (
