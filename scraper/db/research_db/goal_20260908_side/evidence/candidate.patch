+        "expected": {"equals_plain_payload_A": payload["A"]},
+    },
+    "hash_version_bump": {
+        "h1": payload_hash(REC_A, WHITELIST, "h1"),
+        "h2": payload_hash(REC_A, WHITELIST, "h2"),
+        "expected": {"distinct": True},
+    },
+    "manifest": {
+        "manifest": {
+            "contract_version": "1",
+            "batch_id": "batch-001",
+            "source_code": "jisi_future_sou_tools",
