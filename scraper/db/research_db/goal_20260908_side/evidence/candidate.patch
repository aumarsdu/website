+++ b/test_adapters.py
@@ -0,0 +1,159 @@
+"""T04 adapter cases against frozen sample expectations and semantics."""
+
+import json
+import random
+import unittest
+from pathlib import Path
+
+from adapters import ADAPTER_CONFIG, AdapterError, adapt_row, adapt_rows
+from contract import identity_key
+
+SIDE = Path(__file__).resolve().parent
+FROZEN = json.loads(
+    (SIDE / "fixtures" / "t04" / "t04_expected.json").read_text(encoding="utf-8")
+)
+ENTRIES = [
+    "jisi_future_sou_tools",
+    "jisi_future_domestic",
+    "zhongke",
+    "hirep",
+]
+
+
+def load_samples(entry: str) -> list[dict]:
+    path = SIDE / "fixtures" / "t04" / entry / "samples.jsonl"
+    return [
+        json.loads(line)
+        for line in path.read_text(encoding="utf-8").splitlines()
+        if line.strip()
+    ]
+
+
+class AdapterTests(unittest.TestCase):
+    def test_config_matches_frozen(self) -> None:
+        for entry in ENTRIES:
+            self.assertEqual(
+                ADAPTER_CONFIG[entry],
+                FROZEN["entries"][entry]["config"],
+                entry,
+            )
+
+    def test_frozen_expectations_matched_item_by_item(self) -> None:
+        for entry in ENTRIES:
+            samples = load_samples(entry)
+            expectations = FROZEN["entries"][entry]["expectations"]
+            self.assertEqual(len(samples), len(expectations), entry)
+            self.assertGreaterEqual(len(samples), 10, entry)
+            for sample, expected in zip(samples, expectations):
+                adapted = adapt_row(entry, sample)
+                self.assertEqual(adapted["native_id"], expected["native_id"], entry)
+                self.assertEqual(
+                    adapted["field_states"], expected["field_states"], entry
+                )
+                self.assertEqual(adapted["order_key"], expected["order_key"], entry)
+                for field, state in expected["field_states"].items():
+                    if state == "value":
+                        self.assertEqual(
+                            adapted["staging_row"].get(field),
+                            expected["business"][field],
+                            (entry, field),
+                        )
+                    else:
+                        self.assertNotIn(field, adapted["staging_row"], (entry, field))
+
+    def test_identity_separated_across_entries(self) -> None:
+        samples = load_samples("hirep")
+        native = samples[0]["business_id"]
+        keys = {identity_key(entry, native) for entry in ENTRIES}
+        self.assertEqual(len(keys), len(ENTRIES))
+
+    def test_same_entry_two_runs_one_identity(self) -> None:
+        sample = load_samples("jisi_future_sou_tools")[0]
+        first = adapt_row("jisi_future_sou_tools", sample)
+        rerun = dict(sample)
+        rerun["crawled_at"] = "2026-07-03T09:55:05Z"
+        second = adapt_row("jisi_future_sou_tools", rerun)
+        self.assertEqual(first["identity_key"], second["identity_key"])
+        self.assertNotEqual(first["order_key"], second["order_key"])
+
+    def test_disorder_invariant(self) -> None:
+        entry = "zhongke"
+        samples = load_samples(entry)
+        forward = adapt_rows(entry, samples)
+        shuffled = list(samples)
+        random.Random(7).shuffle(shuffled)
+        backward = adapt_rows(entry, shuffled)
+        self.assertEqual(
+            {m["identity_key"] for m in forward["mapped"]},
+            {m["identity_key"] for m in backward["mapped"]},
+        )
+        self.assertEqual(forward["counts"]["rows_in"], backward["counts"]["rows_in"])
+
+    def test_counts_reconcile(self) -> None:
+        for entry in ENTRIES:
+            result = adapt_rows(entry, load_samples(entry))
+            self.assertEqual(
+                result["counts"],
+                {
+                    "rows_in": len(load_samples(entry)),
+                    "mapped": len(load_samples(entry)),
+                    "unmapped": 0,
+                },
+                entry,
+            )
+
+    def test_missing_id_counted_not_dropped(self) -> None:
+        result = adapt_rows("hirep", [{"title": "no id here"}])
+        self.assertEqual(result["counts"], {"rows_in": 1, "mapped": 0, "unmapped": 1})
+        self.assertEqual(result["unmapped"], 1)
+
+    def test_added_unknown_field_no_version_change(self) -> None:
+        sample = load_samples("hirep")[0]
+        base = adapt_row("hirep", sample)
+        noisy = dict(sample)
+        noisy["internal_note"] = "secret"
+        noisy["tracking"] = "abc?utm=x"
+        same = adapt_row("hirep", noisy)
+        self.assertEqual(base["staging_row"], same["staging_row"])
+
+    def test_changed_title_detectable(self) -> None:
+        sample = load_samples("hirep")[0]
+        base = adapt_row("hirep", sample)
+        changed_row = dict(sample)
+        changed_row["title"] = base["staging_row"]["title"] + "（更新）"
+        changed = adapt_row("hirep", changed_row)
+        self.assertNotEqual(
+            base["staging_row"]["title"], changed["staging_row"]["title"]
+        )
+
+    def test_uncertain_instructor_never_invented(self) -> None:
+        row = {"business_id": "H1", "title": "T"}
+        adapted = adapt_row("hirep", row)
+        self.assertEqual(adapted["field_states"]["instructor"], "not_provided")
+        self.assertNotIn("instructor", adapted["staging_row"])
+        a = adapt_row("hirep", {"business_id": "H1", "title": "T", "professor": "张三"})
+        b = adapt_row(
+            "hirep", {"business_id": "H2", "title": "T2", "professor": "张三"}
+        )
+        self.assertEqual(a["staging_row"]["instructor"], "张三")
+        self.assertEqual(b["staging_row"]["instructor"], "张三")
+        self.assertNotEqual(a["identity_key"], b["identity_key"])
+
+    def test_unconfigured_entry_rejected(self) -> None:
+        with self.assertRaisesRegex(AdapterError, "entry_not_configured"):
+            adapt_row("unknown_entry", {})
+
+    def test_same_native_id_across_runs_traced(self) -> None:
+        """Full refresh and incremental rows of one id keep one identity."""
+        sample = load_samples("jisi_future_domestic")[0]
+        incremental = dict(sample)
+        incremental["crawled_at"] = "2026-09-02T04:12:23Z"
+        first = adapt_row("jisi_future_domestic", sample)
+        second = adapt_row("jisi_future_domestic", incremental)
+        self.assertEqual(first["native_id"], second["native_id"])
+        self.assertIsNotNone(first["native_id"])
+        self.assertEqual(first["identity_key"], second["identity_key"])
+
+
+if __name__ == "__main__":
+    unittest.main()

diff --git a/generate_t04_samples.py b/generate_t04_samples.py
new file mode 100644
index 0000000..c03851a
--- /dev/null
+++ b/generate_t04_samples.py
@@ -0,0 +1,157 @@
+"""Generate T04 adapter samples from real registered inputs and freeze expectations.
+
+Samples are deterministic positions (first two, quantiles, last) from the
+registered pilot files, within pilot limits. Expected mappings are produced by
+the dotted-path mapping CONFIG below (independent of adapters.py), one entry
+per sample. Output: fixtures/t04/<entry>/samples.jsonl + fixtures/t04_expected.json.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+SIDE = Path(__file__).resolve().parent
+WORKSPACE = SIDE.parent.parent.parent
+FIX = SIDE / "fixtures" / "t04"
+
+PILOT_LIMITS = {
+    "jisi_future_sou_tools": 25,
+    "jisi_future_domestic": 25,
+    "zhongke": 50,
+    "hirep": 50,
+}
+SAMPLE_FILES = {
+    "jisi_future_sou_tools": "集思未来/output/full_refresh/20260602-full-refresh/sou_tools/processed/records.jsonl",
+    "jisi_future_domestic": "集思未来/output/full_refresh/20260602-full-refresh/domestic/processed/records.jsonl",
+    "zhongke": "中科/output/processed/projects.jsonl",
+    "hirep": "HIREP/output_pbl_full_refresh_20260602/processed/projects.jsonl",
+}
+# per-entry mapping config (the reviewed source of truth for expectations)
+ADAPTER_CONFIG = {
+    "jisi_future_sou_tools": {
+        "id_field": "id",
+        "fields": {
+            "title": "name",
+            "instructor": "raw.dTeacherNickName",
+            "institution": "raw.dTeacherSchool",
+            "start_date": "raw.schoolBegins",
+            "duration": "raw.cycle",
+        },
+        "order_field": "crawled_at",
+    },
+    "jisi_future_domestic": {
+        "id_field": "id",
+        "fields": {
+            "title": "name",
+            "instructor": "raw.dTeacherNickName",
+            "institution": "raw.dTeacherSchool",
+            "start_date": "raw.schoolBegins",
+            "duration": "raw.cycle",
+        },
+        "order_field": "crawled_at",
+    },
+    "zhongke": {
+        "id_field": "id",
+        "fields": {
+            "title": "title",
+            "category": "category",
+            "instructor": "teacher",
+            "institution": "university",
+        },
+        "order_field": "crawled_at",
+    },
+    "hirep": {
+        "id_field": "business_id",
+        "fields": {
+            "title": "title",
+            "category": "category",
+            "instructor": "professor",
+            "institution": "university",
+        },
+        "order_field": "crawled_at",
+    },
+}
+SAMPLE_POSITIONS = {
+    "jisi_future_sou_tools": [1, 2, 3, 6, 9, 12, 15, 18, 21, 25],
+    "jisi_future_domestic": [1, 2, 3, 6, 9, 12, 15, 18, 21, 25],
+    "zhongke": [1, 2, 5, 10, 15, 20, 25, 30, 40, 50],
+    "hirep": [1, 2, 5, 10, 15, 20, 25, 30, 40, 50],
+}
+
+
+def get_path(record: dict, dotted: str):
+    current = record
+    for part in dotted.split("."):
+        if not isinstance(current, dict) or part not in current:
+            return None
+        current = current[part]
+    return current
+
+
+for entry, limit in PILOT_LIMITS.items():
+    rows = []
+    positions = [p for p in SAMPLE_POSITIONS[entry] if p <= limit]
+    with open(WORKSPACE / SAMPLE_FILES[entry], encoding="utf-8") as handle:
+        for index, line in enumerate(handle, start=1):
+            if index > positions[-1]:
+                break
+            if index in positions:
+                rows.append(json.loads(line))
+    entry_dir = FIX / entry
+    entry_dir.mkdir(parents=True, exist_ok=True)
+    with open(entry_dir / "samples.jsonl", "w", encoding="utf-8") as out:
+        out.writelines(
+            json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n" for row in rows
+        )
+    cfg = ADAPTER_CONFIG[entry]
+    expectations = []
+    for row in rows:
+        native_id = row.get(cfg["id_field"])
+        business = {}
+        states = {}
+        for target, source_path in cfg["fields"].items():
+            value = get_path(row, source_path)
+            if value is None:
+                states[target] = "not_provided"
+            elif isinstance(value, str) and value.strip():
+                business[target] = value
+                states[target] = "value"
+            elif isinstance(value, str):
+                states[target] = "explicitly_empty"
+            else:
+                states[target] = "value"
+                business[target] = value
+        expectations.append(
+            {
+                "native_id": str(native_id) if native_id is not None else None,
+                "business": business,
+                "field_states": states,
+                "order_key": row.get(cfg["order_field"]),
+            }
+        )
+    expected_path = entry_dir / "expected.json"
+    expected_path.write_text(
+        json.dumps(
+            {"entry": entry, "config": cfg, "expectations": expectations},
+            ensure_ascii=False,
+            indent=2,
+            sort_keys=True,
+        )
+        + "\n",
+        encoding="utf-8",
+    )
+    print(entry, "samples:", len(rows), "expected:", len(expectations))
+
+all_expected = {"frozen_at": "2026-09-25", "entries": {}}
+for entry in PILOT_LIMITS:
+    all_expected["entries"][entry] = json.loads(
+        (FIX / entry / "expected.json").read_text(encoding="utf-8")
+    )
+out = FIX / "t04_expected.json"
+out.write_text(
+    json.dumps(all_expected, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
+    encoding="utf-8",
+)
+print("frozen:", out, "sha256:", hashlib.sha256(out.read_bytes()).hexdigest())

diff --git a/run_t04_pilot.py b/run_t04_pilot.py
new file mode 100644
index 0000000..686aa23
--- /dev/null
+++ b/run_t04_pilot.py
@@ -0,0 +1,132 @@
+"""T04 pilot: adapt pilot rows from registered real inputs, validate and seal
+through the T08 staging path into candidate_data/pilot/<entry>/.
+
+Pilot limits (原 Spec): jisi entries ≤25 rows each, zhongke/hirep ≤50 rows;
+no assets. Only candidate_data/ is written; sources stay read-only.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import shutil
+from pathlib import Path
+
+from adapters import adapt_rows
+from contract import canonical_json
+from stage_validator import validate_and_seal
+
+SIDE = Path(__file__).resolve().parent
+WORKSPACE = SIDE.parent.parent.parent
+PILOT_FILES = {
+    "jisi_future_sou_tools": (
+        WORKSPACE
+        / "集思未来/output/full_refresh/20260602-full-refresh/sou_tools/processed/records.jsonl",
+        25,
+    ),
+    "jisi_future_domestic": (
+        WORKSPACE
+        / "集思未来/output/full_refresh/20260602-full-refresh/domestic/processed/records.jsonl",
+        25,
+    ),
+    "zhongke": (WORKSPACE / "中科/output/processed/projects.jsonl", 50),
+    "hirep": (
+        WORKSPACE / "HIREP/output_pbl_full_refresh_20260602/processed/projects.jsonl",
+        50,
+    ),
+}
+PILOT = SIDE / "candidate_data" / "pilot"
+
+
+def sha(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def build_staging(entry: str, source: Path, limit: int) -> Path:
+    rows = []
+    with open(source, encoding="utf-8") as handle:
+        for index, line in enumerate(handle, start=1):
+            if index > limit:
+                break
+            if line.strip():
+                rows.append(json.loads(line))
+    result = adapt_rows(entry, rows)
+    staging = PILOT / entry / "staging"
+    if staging.exists():
+        shutil.rmtree(staging)
+    staging.mkdir(parents=True)
+    with open(staging / "records.jsonl", "w", encoding="utf-8") as out:
+        out.writelines(
+            canonical_json(adapted["staging_row"]) + "\n"
+            for adapted in result["mapped"]
+        )
+    data = (staging / "records.jsonl").read_bytes()
+    manifest = {
+        "contract_version": "1",
+        "batch_id": f"pilot-{entry}-20260925",
+        "source_code": entry,
+        "capture_mode": "full",
+        "captured_at": max(
+            (m["order_key"] for m in result["mapped"] if m["order_key"]),
+            default="unknown",
+        ),
+        "observed_order": "unknown",
+        "coverage": "partial",
+        "adapter_version": "t04-v1",
+        "mapping_version": "t04-v1",
+        "hash_version": "h1",
+        "scope": {"entry": entry, "pilot_rows": limit},
+        "input_files": [
+            {
+                "relative_path": "records.jsonl",
+                "sha256": sha(data),
+                "byte_size": len(data),
+                "row_count": len(result["mapped"]),
+                "format": "jsonl",
+                "role": "fact",
+            }
+        ],
+    }
+    (staging / "manifest.json").write_text(
+        canonical_json(manifest) + "\n", encoding="utf-8"
+    )
+    return staging
+
+
+def main() -> int:
+    if PILOT.exists():
+        shutil.rmtree(PILOT)
+    report = {
+        "checked_at": "2026-09-25",
+        "limits": {k: v[1] for k, v in PILOT_FILES.items()},
+        "entries": {},
+    }
+    for entry, (source, limit) in PILOT_FILES.items():
+        staging = build_staging(entry, source, limit)
+        target = PILOT / entry / "sealed"
+        verdict = validate_and_seal(staging, target)
+        report["entries"][entry] = {
+            "rows_in": limit,
+            "staging_rows": len(
+                (staging / "records.jsonl").read_text(encoding="utf-8").splitlines()
+            ),
+            "verdict": verdict,
+        }
+        if verdict["sealed"]:
+            report["entries"][entry]["seal"] = json.loads(
+                (target / "seal.json").read_text(encoding="utf-8")
+            )["batch_sha256"][:16]
+    out = SIDE / "evidence" / "t04_pilot.json"
+    with open(out, "w", encoding="utf-8") as handle:
+        handle.write(json.dumps(report, ensure_ascii=False, indent=2) + "\n")
+    print(
+        json.dumps(
+            {k: v["verdict"].get("counts") for k, v in report["entries"].items()},
+            ensure_ascii=False,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

