diff --git a/stage_validator.py b/stage_validator.py
new file mode 100644
index 0000000..5af6a92
--- /dev/null
+++ b/stage_validator.py
@@ -0,0 +1,320 @@
+"""T08 strong staging validator with atomic temp-dir sealing.
+
+Verdicts are frozen in fixtures/t08_expected.json (generated before this
+implementation). Output contains approved fields only; raw rows and large SQL
+are never printed.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import shutil
+from pathlib import Path
+from typing import Any
+
+from contract import (
+    ContractError,
+    canonical_json,
+    field_state,
+    identity_key,
+    manifest_digest,
+    observation_key,
+    payload_hash,
+    validate_manifest,
+)
+
+VALIDATOR_VERSION = "t08-v1"
+SIDEC = Path(__file__).resolve().parent
+CONFIG = json.loads((SIDEC / "contract_config.json").read_text(encoding="utf-8"))
+
+
+class StageError(ValueError):
+    """The staging batch failed validation and cannot be sealed."""
+
+
+def _sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        while chunk := handle.read(1 << 20):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _load_manifest(staging: Path) -> dict[str, Any]:
+    manifest_path = staging / "manifest.json"
+    if not manifest_path.is_file():
+        raise StageError("empty_input")
+    try:
+        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    except (json.JSONDecodeError, UnicodeError) as exc:
+        raise StageError("contract_invalid") from exc
+    try:
+        validate_manifest(manifest)
+    except ContractError as exc:
+        raise StageError("contract_invalid") from exc
+    if not manifest["input_files"]:
+        raise StageError("empty_input")
+    return manifest
+
+
+def _input_path(staging: Path, relative: str) -> Path:
+    rel = Path(relative)
+    if rel.is_absolute() or ".." in rel.parts or not rel.parts:
+        raise StageError("contract_invalid")
+    path = staging / rel
+    current = staging.resolve()
+    for part in rel.parts:
+        current = current / part
+        if current.is_symlink():
+            raise StageError("contract_invalid")
+    return path
+
+
+def _check_inputs(staging: Path, manifest: dict[str, Any]) -> dict[str, str]:
+    digests: dict[str, str] = {}
+    for entry in manifest["input_files"]:
+        rel = entry["relative_path"]
+        path = _input_path(staging, rel)
+        if not path.is_file():
+            raise StageError("input_missing")
+        actual = _sha256_file(path)
+        if actual != entry["sha256"] or path.stat().st_size != entry["byte_size"]:
+            raise StageError("input_changed")
+        digests[rel] = actual
+        rows = 0
+        parse_error = False
+        with open(path, encoding="utf-8") as handle:
+            for line in handle:
+                if not line.strip():
+                    continue
+                rows += 1
+                try:
+                    json.loads(line)
+                except json.JSONDecodeError:
+                    parse_error = True
+        if rows != entry["row_count"]:
+            raise StageError("row_count_mismatch")
+        if parse_error:
+            raise StageError("row_truncated")
+    return digests
+
+
+def _classify(staging: Path, manifest: dict[str, Any]) -> dict[str, Any]:
+    source = manifest["source_code"]
+    config = CONFIG["sources"].get(source)
+    if config is None:
+        raise StageError("contract_invalid")
+    whitelist = list(config["whitelist"])
+    batch_id = manifest["batch_id"]
+    counts = {"accepted": 0, "duplicate": 0, "quarantined": 0, "rejected": 0}
+    rows_read = 0
+    seen: set[str] = set()
+    accepted_ids: set[str] = set()
+    payload_by_id: dict[str, set[str]] = {}
+    sealed_rows: list[dict[str, Any]] = []
+
+    records_rel = manifest["input_files"][0]["relative_path"]
+    with open(staging / records_rel, encoding="utf-8") as handle:
+        for line in handle:
+            if not line.strip():
+                continue
+            rows_read += 1
+            try:
+                row = json.loads(line)
+            except json.JSONDecodeError:
+                counts["rejected"] += 1
+                continue
+            native_id = row.get("id")
+            if not isinstance(native_id, str) or not native_id:
+                counts["rejected"] += 1
+                continue
+            bad_type = any(
+                key in row and row[key] is not None and not isinstance(row[key], str)
+                for key in whitelist
+            )
+            if bad_type:
+                counts["quarantined"] += 1
+                continue
+            ident = identity_key(source, native_id)
+            payload = payload_hash(row, whitelist, manifest["hash_version"])
+            context_key = str(row.get("context_key") or "default")
+            okey = observation_key(batch_id, ident, context_key, payload)
+            if okey in seen:
+                counts["duplicate"] += 1
+                continue
+            seen.add(okey)
+            counts["accepted"] += 1
+            accepted_ids.add(native_id)
+            payload_by_id.setdefault(native_id, set()).add(payload)
+            sealed_rows.append(
+                {
+                    "batch_id": batch_id,
+                    "context_key": context_key,
+                    "field_states": {key: field_state(row, key) for key in whitelist},
+                    "identity_key": ident,
+                    "observation_key": okey,
+                    "order_key": row.get("crawled_at"),
+                    "payload_hash": payload,
+                    "business": {k: row[k] for k in whitelist if k in row},
+                }
+            )
+
+    if (
+        counts["accepted"]
+        + counts["duplicate"]
+        + counts["quarantined"]
+        + counts["rejected"]
+        != rows_read
+    ):
+        raise StageError("row_count_mismatch")
+
+    observation_errors: list[str] = []
+    for entry in manifest["input_files"]:
+        if entry.get("role") != "observation":
+            continue
+        with open(staging / entry["relative_path"], encoding="utf-8") as handle:
+            for line in handle:
+                if not line.strip():
+                    continue
+                ref = json.loads(line)
+                if ref.get("record") not in accepted_ids:
+                    observation_errors.append("observation_record_unknown")
+                elif ref.get("payload_ref") not in payload_by_id.get(
+                    ref.get("record", ""), set()
+                ):
+                    observation_errors.append("observation_payload_unknown")
+    if observation_errors:
+        raise StageError("|".join(dict.fromkeys(observation_errors)))
+
+    return {"counts": counts, "rows_read": rows_read, "sealed_rows": sealed_rows}
+
+
+def _seal(
+    staging: Path,
+    target: Path,
+    manifest: dict[str, Any],
+    result: dict[str, Any],
+    input_digests: dict[str, str],
+) -> None:
+    if target.exists():
+        raise StageError("seal_target_exists")
+    seal = {
+        "batch_id": manifest["batch_id"],
+        "contract_version": manifest["contract_version"],
+        "counts": result["counts"],
+        "hash_version": manifest["hash_version"],
+        "input_files": input_digests,
+        "manifest_digest": manifest_digest(manifest),
+        "rows_read": result["rows_read"],
+        "source_code": manifest["source_code"],
+        "validator_version": VALIDATOR_VERSION,
+    }
+    temp = target.parent / f".tmp-seal-{target.name}"
+    if temp.exists():
+        shutil.rmtree(temp)
+    temp.mkdir(parents=True)
+    try:
+        rows_path = temp / "batch.jsonl"
+        with open(rows_path, "w", encoding="utf-8") as handle:
+            handle.writelines(
+                canonical_json(row) + "\n" for row in result["sealed_rows"]
+            )
+        seal["batch_sha256"] = _sha256_file(rows_path)
+        (temp / "seal.json").write_text(canonical_json(seal) + "\n", encoding="utf-8")
+        for path in temp.iterdir():
+            with open(path, "rb") as handle:
+                os.fsync(handle.fileno())
+        os.replace(temp, target)
+    except OSError:
+        if temp.exists():
+            shutil.rmtree(temp)
+        raise
+
+
+def validate_and_seal(staging: Path, target: Path) -> dict[str, Any]:
+    """Validate one staging batch and atomically seal an importable output."""
+    try:
+        manifest = _load_manifest(staging)
+        input_digests = _check_inputs(staging, manifest)
+        result = _classify(staging, manifest)
+    except StageError as exc:
+        return {"sealed": False, "error": str(exc)}
+    try:
+        _seal(staging, target, manifest, result, input_digests)
+    except StageError as exc:
+        return {"sealed": False, "error": str(exc), "counts": result["counts"]}
+    return {
+        "sealed": True,
+        "counts": result["counts"],
+        "rows_read": result["rows_read"],
+        "sealed_rows": len(result["sealed_rows"]),
+    }
+
+
+def validate_only(staging: Path) -> dict[str, Any]:
+    """Read-only validation verdict: no target directory is ever created."""
+    try:
+        manifest = _load_manifest(staging)
+        _check_inputs(staging, manifest)
+        result = _classify(staging, manifest)
+    except StageError as exc:
+        return {"sealed": False, "error": str(exc)}
+    return {
+        "sealed": False,
+        "would_seal": True,
+        "counts": result["counts"],
+        "rows_read": result["rows_read"],
+        "sealed_rows": len(result["sealed_rows"]),
+    }
+
+
+def verify_seal(staging: Path, target: Path) -> None:
+    """Re-check a sealed batch against its staging inputs; mutation voids it."""
+    seal = json.loads((target / "seal.json").read_text(encoding="utf-8"))
+    manifest = json.loads((staging / "manifest.json").read_text(encoding="utf-8"))
+    if seal["manifest_digest"] != manifest_digest(manifest):
+        raise StageError("input_changed")
+    for entry in manifest["input_files"]:
+        if (
+            _sha256_file(staging / entry["relative_path"])
+            != seal["input_files"][entry["relative_path"]]
+        ):
+            raise StageError("input_changed")
+    batch = target / "batch.jsonl"
+    if _sha256_file(batch) != seal["batch_sha256"]:
+        raise StageError("input_changed")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--staging", type=Path, required=True)
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument(
+        "--dry-run",
+        action="store_true",
+        help="read-only verdict; nothing is sealed",
+    )
+    mode.add_argument(
+        "--seal",
+        action="store_true",
+        help="validate and atomically seal the batch into --target",
+    )
+    parser.add_argument("--target", type=Path)
+    args = parser.parse_args()
+    if args.target is None and args.seal:
+        parser.error("--seal requires --target")
+    if args.dry_run:
+        verdict = validate_only(args.staging)
+        print(json.dumps({**verdict, "mode": "dry-run"}, ensure_ascii=False))
+        return 0 if verdict.get("would_seal") else 1
+    assert args.target is not None
+    verdict = validate_and_seal(args.staging, args.target)
+    print(json.dumps({**verdict, "mode": "seal"}, ensure_ascii=False))
+    return 0 if verdict["sealed"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

diff --git a/test_stage_validator.py b/test_stage_validator.py
new file mode 100644
index 0000000..f470d93
--- /dev/null
+++ b/test_stage_validator.py
@@ -0,0 +1,221 @@
+"""T08 staging validator cases against frozen fixture verdicts."""
+
+import json
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+
+from stage_validator import (
+    StageError,
+    validate_and_seal,
+    validate_only,
+    verify_seal,
+)
+
+SIDE = Path(__file__).resolve().parent
+FIXTURES = SIDE / "fixtures" / "t08"
+EXPECTED = json.loads(
+    (SIDE / "fixtures" / "t08_expected.json").read_text(encoding="utf-8")
+)["cases"]
+
+
+class StageValidatorTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.work = Path(self.temp.name)
+
+    def run_case(self, name: str) -> dict:
+        target = self.work / name
+        return validate_and_seal(FIXTURES / name, target)
+
+    def assert_sealed_false(self, verdict: dict, error: str) -> None:
+        self.assertFalse(verdict["sealed"])
+        self.assertEqual(verdict["error"], error)
+
+    def test_case_ok_sealed_with_frozen_verdict(self) -> None:
+        verdict = self.run_case("case_ok")
+        expected = EXPECTED["case_ok"]["expected"]
+        self.assertTrue(verdict["sealed"])
+        self.assertEqual(
+            verdict["counts"],
+            {
+                "accepted": expected["accepted"],
+                "duplicate": expected["duplicate"],
+                "quarantined": expected["quarantined"],
+                "rejected": expected["rejected"],
+            },
+        )
+        self.assertEqual(verdict["rows_read"], expected["rows_read"])
+        self.assertEqual(verdict["sealed_rows"], expected["sealed_rows"])
+
+    def test_case_ok_scrubbed_output(self) -> None:
+        self.run_case("case_ok")
+        text = (self.work / "case_ok" / "batch.jsonl").read_text(encoding="utf-8")
+        for forbidden in EXPECTED["case_ok"]["expected"]["scrubbed_fields_absent"]:
+            self.assertNotIn(f'"{forbidden}"', text)
+
+    def test_case_bad_json_count_mismatch(self) -> None:
+        verdict = self.run_case("case_bad_json")
+        self.assert_sealed_false(
+            verdict, EXPECTED["case_bad_json"]["expected"]["error"]
+        )
+        self.assertFalse((self.work / "case_bad_json").exists())
+
+    def test_case_truncated_detected(self) -> None:
+        verdict = self.run_case("case_truncated")
+        self.assert_sealed_false(
+            verdict, EXPECTED["case_truncated"]["expected"]["error"]
+        )
+
+    def test_case_missing_file(self) -> None:
+        verdict = self.run_case("case_missing_file")
+        self.assert_sealed_false(
+            verdict, EXPECTED["case_missing_file"]["expected"]["error"]
+        )
+
+    def test_case_hash_mismatch(self) -> None:
+        verdict = self.run_case("case_hash_mismatch")
+        self.assert_sealed_false(
+            verdict, EXPECTED["case_hash_mismatch"]["expected"]["error"]
+        )
+
+    def test_case_empty_dir(self) -> None:
+        verdict = self.run_case("case_empty_dir")
+        self.assert_sealed_false(
+            verdict, EXPECTED["case_empty_dir"]["expected"]["error"]
+        )
+
+    def test_case_observation_bad_refs(self) -> None:
+        verdict = self.run_case("case_observations_bad_refs")
+        self.assertFalse(verdict["sealed"])
+        for error in EXPECTED["case_observations_bad_refs"]["expected"]["errors"]:
+            self.assertIn(error, verdict["error"])
+
+    def test_sealing_is_deterministic(self) -> None:
+        self.run_case("case_ok")
+        first = (self.work / "case_ok" / "seal.json").read_bytes()
+        second_target = self.work / "case_ok_second"
+        validate_and_seal(FIXTURES / "case_ok", second_target)
+        second = (second_target / "seal.json").read_bytes()
+        self.assertEqual(first, second)
+
+    def test_seal_target_exists_rejected(self) -> None:
+        self.run_case("case_ok")
+        verdict = validate_and_seal(FIXTURES / "case_ok", self.work / "case_ok")
+        self.assert_sealed_false(verdict, "seal_target_exists")
+
+    def test_input_change_after_seal_voids_seal(self) -> None:
+        staging = self.work / "mutable_staging"
+        shutil.copytree(FIXTURES / "case_ok", staging)
+        target = self.work / "mutable_target"
+        verdict = validate_and_seal(staging, target)
+        self.assertTrue(verdict["sealed"])
+        verify_seal(staging, target)
+        records = staging / "records.jsonl"
+        records.write_text(
+            records.read_text(encoding="utf-8").replace("项目A", "项目Y"),
+            encoding="utf-8",
+        )
+        with self.assertRaisesRegex(StageError, "input_changed"):
+            verify_seal(staging, target)
+
+    def test_no_temp_leftover_on_failure(self) -> None:
+        self.run_case("case_bad_json")
+        leftovers = [
+            p.name for p in self.work.iterdir() if p.name.startswith(".tmp-seal-")
+        ]
+        self.assertEqual(leftovers, [])
+
+    def test_dry_run_creates_no_target(self) -> None:
+        verdict = validate_only(FIXTURES / "case_ok")
+        self.assertTrue(verdict["would_seal"])
+        self.assertEqual(verdict["sealed_rows"], 2)
+        self.assertEqual(list(self.work.iterdir()), [])
+
+    def test_traversal_and_symlink_inputs_rejected(self) -> None:
+        staging = self.work / "evil_staging"
+        shutil.copytree(FIXTURES / "case_ok", staging)
+        outside = self.work / "outside.jsonl"
+        outside.write_text("{}\n", encoding="utf-8")
+        (staging / "link.jsonl").symlink_to(outside)
+        manifest_path = staging / "manifest.json"
+        for relative in ("../outside.jsonl", "link.jsonl"):
+            manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+            manifest["input_files"].append(
+                {
+                    "relative_path": relative,
+                    "sha256": "0" * 64,
+                    "byte_size": 3,
+                    "row_count": 1,
+                    "format": "jsonl",
+                    "role": "fact",
+                }
+            )
+            manifest_path.write_text(
+                json.dumps(manifest, ensure_ascii=False), encoding="utf-8"
+            )
+            verdict = validate_only(staging)
+            self.assertFalse(verdict["sealed"])
+            self.assertEqual(verdict["error"], "contract_invalid")
+
+    def test_valid_observations_pass(self) -> None:
+        import hashlib
+
+        from contract import payload_hash
+
+        staging = self.work / "obs_ok_staging"
+        shutil.copytree(FIXTURES / "case_ok", staging)
+        manifest_path = staging / "manifest.json"
+        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+        records = [
+            json.loads(line)
+            for line in (staging / "records.jsonl")
+            .read_text(encoding="utf-8")
+            .splitlines()
+            if line.strip()
+        ]
+        wl = json.loads(
+            Path(__file__).with_name("contract_config.json").read_text(encoding="utf-8")
+        )["sources"]["jisi_future_sou_tools"]["whitelist"]
+        payloads = sorted(
+            (
+                (r["id"], payload_hash(r, wl, "h1"))
+                for r in records
+                if r.get("id") in ("SYN-001", "SYN-002")
+            ),
+            key=lambda item: item[1],
+        )
+        obs_rows = [
+            {
+                "record": rec_id,
+                "context_key": "detail",
+                "payload_ref": payload,
+                "order_key": "2026-06-02T07:52:16Z",
+            }
+            for rec_id, payload in payloads
+        ]
+        obs_text = "".join(json.dumps(r, sort_keys=True) + "\n" for r in obs_rows)
+        (staging / "observations.jsonl").write_text(obs_text, encoding="utf-8")
+        manifest["input_files"].append(
+            {
+                "relative_path": "observations.jsonl",
+                "sha256": hashlib.sha256(obs_text.encode("utf-8")).hexdigest(),
+                "byte_size": len(obs_text.encode("utf-8")),
+                "row_count": len(obs_rows),
+                "format": "jsonl",
+                "role": "observation",
+            }
+        )
+        manifest_path.write_text(
+            json.dumps(manifest, ensure_ascii=False), encoding="utf-8"
+        )
+        target = self.work / "obs_ok_target"
+        verdict = validate_and_seal(staging, target)
+        self.assertTrue(verdict["sealed"], verdict)
+        self.assertEqual(verdict["sealed_rows"], 2)
