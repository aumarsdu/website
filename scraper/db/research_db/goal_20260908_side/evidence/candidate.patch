+            inserted_sum += counts["inserted_observations"]
+        self.assertEqual(inserted_sum, 3)
+        total = self.query("SELECT count(*) FROM observations;")[0]
+        self.assertEqual(total, "3")
+
+    def test_disconnect_mid_flight_recovers(self) -> None:
