diff --git a/contract.md b/contract.md
new file mode 100644
index 0000000..e0ade8b
--- /dev/null
+++ b/contract.md
@@ -0,0 +1,52 @@
+# T02 契约说明（candidate v1）
+
+- 状态：候选，待独立复核（golden 期望 + 实现一致性 + 反例覆盖）。
+- 机器可校验期望：`golden/t02_expectations.json`（冻结 sha256 见 evidence；由 `generate_golden.py` 的算法规格块生成，先于 `contract.py` 实现）。来源配置：`contract_config.json`（仅固定机制；各源白名单/身份字段在 T04/T06/T07 冻结为真实映射）。
+
+## 1. 规则总纲
+
+| 规则 | 定义 | 版本化 |
+| --- | --- | --- |
+| canonical JSON | `json.dumps(v, ensure_ascii=False, sort_keys=True, separators=(",",":"))` 的 UTF-8 文本 | 随 contract_version |
+| 身份编码 | `canonical_json({"native_id": <原样字符串>, "source": <source_code>})`；`string_exact`，禁止数字归一（`0`≠`001`），无分隔符拼接歧义 | contract_version |
+| 内容哈希 | `sha256(canonical_json({"business": <白名单内且出现的字段>, "hash_version": <v>}))`；排除采集时间、本地路径、随机值、处理日志 | hash_version（现为 h1） |
+| 观察键 | `canonical_json({"batch", "context", "payload", "record"})`；batch+record 不足以去重，多入口上下文不丢 | contract_version |
+| 字段状态 | `value / explicitly_empty / not_provided / extraction_failed` 四态互斥 | contract_version |
+
+## 2. 可信观察顺序与投影（resolve_projection）
+
+1. 投影取**已知序**最大的观察；order key 为 ISO-8601 UTC 时间字符串（字典序即时间序），T09/T10 消费前不得更改该类型约定；观察到达顺序（行序、导入序）永不决定胜者。
+2. 最大序上出现多个不同 payload → `conflict`：保留全部冲突 payload，投影回退到此前最近的单 payload 序（最后已验证投影）；无可回退则 `payload=null` 且状态仍为 `conflict`（fail-closed，冲突可见，不假装无冲突）。
+3. `observed_order=unknown` 的观察只进历史，永不参与投影。
+4. A→B→A 保留三条观察，投影=A（历史不塌缩）。
+
+## 3. 批次 manifest 规则
+
+- 必填 12 字段见 `contract.REQUIRED_MANIFEST_FIELDS`；缺项或 `contract_version` 不符 → `contract_invalid`。
+- `manifest_digest = sha256(canonical_json(manifest))`；同 `batch_id` 不同 digest → `identity_conflict` 拒绝。
+- 字节相同、解析版本不同 → 新建 transformation_run（`canonical_json({batch, adapter_version})`），不伪造新采集事件，原观察保留。
+
+## 4. 每来源身份配置（候选）
+
+| source | id_field | 状态 |
+| --- | --- | --- |
+| jisi_future_sou_tools / jisi_future_domestic | `id` | candidate_until_T04（两入口独立 namespace） |
+| zhongke | `uuid` | candidate_until_T04_precedence_check |
+| hirep | `business_id` | candidate_until_T04 |
+| yanqu_ocr | 无 | no_reliable_id_candidate_only（category+poster_file 是证据位置，非项目身份；T06 决定） |
+| yinzhi_public | 无 | no_reliable_id_candidate_only（front-matter 编码标识页面，非项目；T07 决定） |
+
+不按标题或文件路径固化身份；不默认假定同供应商入口共用 ID 空间。
+
+## 5. 变更与兼容
+
+- 任何规则变更必须升 `hash_version` 或 `contract_version`；旧哈希/旧观察不重算，历史保留。
+- 白名单冻结于 T04/T06/T07；届时金额改十进制定点、日期补原文+精度+时区等表达变化会改变哈希，必须按本节升 hash_version。
+- `validate_manifest` 是形状级校验（必填字段与版本）；`input_files` 子字段、`capture_mode`/`coverage` 枚举与行数对账由 T08 强校验负责，路径越界由 T01 target_guard 负责。
+- golden 文件冻结后不得原地修改；修订通过新 hash_version 的新 golden 交付，并在本文件记录兼容说明。
+
+## 6. 与原 Spec 条款对应
+
+- §3.2 批次 manifest 全字段/对账/拒绝语义 → 第 3 节。
+- §3.3 ID 编码、字段状态、哈希排除、同序冲突、unknown 顺序、not_seen 不推断下架 → 第 1、2 节（not_seen 在 T09/T10 落库）。
+- §3.4 错误类别 → `contract_invalid`、`identity_conflict`（本模块）；其余类别归 T08/T09。

diff --git a/pg_candidate.py b/pg_candidate.py
new file mode 100644
index 0000000..2edc4c2
--- /dev/null
+++ b/pg_candidate.py
@@ -0,0 +1,217 @@
+"""Candidate PostgreSQL cluster management. Isolated: own data dir, socket dir, port.
+
+The candidate cluster never uses the legacy endpoint (socket /tmp, port 55432).
+All paths live under candidate_pg/ inside the isolated side root.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import shutil
+import subprocess
+import time
+from pathlib import Path
+
+SIDE = Path(__file__).resolve().parent
+DATA_DIR = SIDE / "candidate_pg" / "data"
+LOG_FILE = SIDE / "candidate_pg" / "postgres.log"
+PORT = 55441
+HOST = "127.0.0.1"  # TCP loopback only; unix sockets disabled (path-length limit, /tmp:55432 isolation)
+SUPERUSER = "candidate_t03"
+
+PG_BIN = Path("/opt/homebrew/opt/postgresql@16/bin")
+
+
+class ClusterError(RuntimeError):
+    """A candidate cluster operation failed."""
+
+
+def _run(cmd: list[str], **kwargs: object) -> subprocess.CompletedProcess[str]:
+    result = subprocess.run(
+        cmd,
+        capture_output=True,
+        text=True,
+        check=False,
+        **kwargs,  # type: ignore[arg-type]
+    )
+    if result.returncode != 0:
+        raise ClusterError(
+            f"command {' '.join(cmd)} failed ({result.returncode}): "
+            f"{result.stderr.strip()[-400:]}"
+        )
+    return result
+
+
+def _psql_base(database: str) -> list[str]:
+    return [
+        str(PG_BIN / "psql"),
+        "-h",
+        HOST,
+        "-p",
+        str(PORT),
+        "-U",
+        SUPERUSER,
+        "-d",
+        database,
+        "-v",
+        "ON_ERROR_STOP=1",
+        "-X",
+        "-q",
+        "-tA",
+    ]
+
+
+def psql(database: str, sql: str) -> subprocess.CompletedProcess[str]:
+    """Run SQL with ON_ERROR_STOP; any error raises."""
+    return _run(_psql_base(database) + ["-c", sql])
+
+
+def psql_file(database: str, path: Path) -> subprocess.CompletedProcess[str]:
+    return _run(_psql_base(database) + ["-f", str(path)])
+
+
+def is_running() -> bool:
+    probe = subprocess.run(
+        _psql_base("postgres") + ["-c", "SELECT 1"],
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    return probe.returncode == 0
+
+
+def init_cluster() -> None:
+    """Initialize data dir and start the isolated cluster (idempotent)."""
+    if is_running():
+        return
+    if not DATA_DIR.exists():
+        _run(
+            [
+                str(PG_BIN / "initdb"),
+                "-D",
+                str(DATA_DIR),
+                "-U",
+                SUPERUSER,
+                "-A",
+                "trust",
+                "-E",
+                "UTF8",
+                "--no-instructions",
+            ]
+        )
+    _run(
+        [
+            str(PG_BIN / "pg_ctl"),
+            "-D",
+            str(DATA_DIR),
+            "-o",
+            f"-p {PORT} -c listen_addresses='127.0.0.1' -c unix_socket_directories=''",
+            "-l",
+            str(LOG_FILE),
+            "start",
+        ]
+    )
+    for _ in range(50):
+        if is_running():
+            return
+        time.sleep(0.2)
+    raise ClusterError("candidate cluster did not become ready")
+
+
+def stop_cluster() -> None:
+    if DATA_DIR.exists():
+        subprocess.run(
+            [str(PG_BIN / "pg_ctl"), "-D", str(DATA_DIR), "stop", "-m", "fast"],
+            capture_output=True,
+            text=True,
+            check=False,
+        )
+
+
+def create_database(name: str) -> None:
+    _run(
+        [
+            str(PG_BIN / "createdb"),
+            "-h",
+            HOST,
+            "-p",
+            str(PORT),
+            "-U",
+            SUPERUSER,
+            name,
+        ]
+    )
+
+
+def drop_database(name: str) -> None:
+    _run(
+        [
+            str(PG_BIN / "dropdb"),
+            "--if-exists",
+            "-h",
+            HOST,
+            "-p",
+            str(PORT),
+            "-U",
+            SUPERUSER,
+            name,
+        ]
+    )
+
+
+def database_exists(name: str) -> bool:
+    probe = subprocess.run(
+        _psql_base("postgres")
+        + ["-tAc", f"SELECT 1 FROM pg_database WHERE datname='{name}'"],
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    return probe.stdout.strip() == "1"
+
+
+def server_version() -> str:
+    result = psql("postgres", "SHOW server_version_num;")
+    return result.stdout.strip()
+
+
+def destroy_cluster() -> None:
+    """Stop the cluster and remove the data dir entirely (test reset)."""
+    stop_cluster()
+    if (SIDE / "candidate_pg").exists():
+        shutil.rmtree(SIDE / "candidate_pg")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("action", choices=["init", "stop", "status", "destroy"])
+    args = parser.parse_args()
+    try:
+        if args.action == "init":
+            init_cluster()
+            print(json.dumps({"status": "running", "port": PORT, "host": HOST}))
+        elif args.action == "stop":
+            stop_cluster()
+            print(json.dumps({"status": "stopped"}))
+        elif args.action == "destroy":
+            destroy_cluster()
+            print(json.dumps({"status": "destroyed"}))
+        else:
+            print(
+                json.dumps(
+                    {
+                        "status": "running" if is_running() else "stopped",
+                        "port": PORT,
+                        "host": HOST,
+                    }
+                )
+            )
+    except ClusterError as exc:
+        print(json.dumps({"status": "error", "error": str(exc)}))
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

diff --git a/run_migrations.py b/run_migrations.py
new file mode 100644
index 0000000..9d1203b
--- /dev/null
+++ b/run_migrations.py
@@ -0,0 +1,141 @@
+"""Versioned migration runner for the candidate model.
+
+Each migration runs in a single transaction together with its ledger insert.
+Applied versions are skipped by checksum; a checksum mismatch fails loudly
+instead of being silently skipped. Interruption leaves the ledger untouched,
+so re-running resumes cleanly from the last committed checkpoint.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import sys
+from pathlib import Path
+from typing import TextIO
+
+import pg_candidate
+
+EXIT_OK = 0
+EXIT_SQL_ERROR = 1
+EXIT_CHECKSUM_CONFLICT = 2
+
+
+class Migration:
+    def __init__(self, path: Path) -> None:
+        self.version = path.name.split("_", 1)[0]
+        self.name = path.name
+        self.checksum = hashlib.sha256(path.read_bytes()).hexdigest()
+        self.sql = path.read_text(encoding="utf-8")
+
+    def ledger_sql(self) -> str:
+        # Migration body runs verbatim inside one transaction with its ledger row;
+        # only version/checksum (safe charset by construction) enter the INSERT.
+        return (
+            "BEGIN;\n"
+            + self.sql
+            + "\n"
+            + f"INSERT INTO schema_migrations (version, checksum) "
+            f"VALUES ('{self.version}', '{self.checksum}');\n" + "COMMIT;"
+        )
+
+
+def applied_versions(database: str) -> dict[str, str]:
+    if not pg_candidate.database_exists(database):
+        return {}
+    probe = pg_candidate.psql(
+        database, "SELECT to_regclass('public.schema_migrations') IS NOT NULL;"
+    )
+    if probe.stdout.strip() != "t":
+        return {}
+    probe = pg_candidate.psql(
+        database,
+        "SELECT version, checksum FROM schema_migrations ORDER BY version;",
+    )
+    result: dict[str, str] = {}
+    for line in probe.stdout.splitlines():
+        if "|" in line:
+            version, checksum = line.split("|", 1)
+            result[version] = checksum
+    return result
+
+
+def discover(directory: Path) -> list[Migration]:
+    return [
+        Migration(path)
+        for path in sorted(directory.glob("*.sql"))
+        if path.name[0].isdigit()
+    ]
+
+
+def run(database: str, directory: Path, log: TextIO) -> int:
+    pending_all = discover(directory)
+    applied = applied_versions(database)
+    for migration in pending_all:
+        if migration.version in applied:
+            if applied[migration.version] != migration.checksum:
+                print(
+                    f"checksum conflict for {migration.version}: "
+                    f"applied={applied[migration.version]} current={migration.checksum}",
+                    file=log,
+                )
+                return EXIT_CHECKSUM_CONFLICT
+            print(f"skip {migration.version} (already applied)", file=log)
+    for migration in pending_all:
+        if migration.version in applied:
+            continue
+        print(f"apply {migration.version}", file=log)
+        try:
+            pg_candidate.psql(database, migration.ledger_sql())
+        except pg_candidate.ClusterError as exc:
+            print(f"migration {migration.version} failed: {exc}", file=log)
+            return EXIT_SQL_ERROR
+        print(f"applied {migration.version}", file=log)
+    return EXIT_OK
+
+
+def plan(database: str, directory: Path, log: TextIO) -> int:
+    """Read-only: report applied/pending state without touching the database."""
+    applied = applied_versions(database)
+    for migration in discover(directory):
+        if migration.version in applied:
+            state = "applied"
+            if applied[migration.version] != migration.checksum:
+                state = "CHECKSUM_CONFLICT"
+            print(f"{migration.version} {state}", file=log)
+        else:
+            print(f"{migration.version} pending", file=log)
+    return EXIT_OK
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--database", required=True)
+    parser.add_argument(
+        "--dir",
+        type=Path,
+        default=Path(__file__).resolve().parent / "migrations",
+    )
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument(
+        "--dry-run",
+        action="store_true",
+        help="read-only: list pending/applied migrations, apply nothing",
+    )
+    mode.add_argument("--apply", action="store_true", help="apply pending migrations")
+    args = parser.parse_args()
+    if args.dry_run:
+        code = plan(args.database, args.dir, sys.stdout)
+        print(json.dumps({"exit_code": code, "mode": "dry-run"}))
+        return code
+    pg_candidate.init_cluster()
+    if not pg_candidate.database_exists(args.database):
+        pg_candidate.create_database(args.database)
+    code = run(args.database, args.dir, sys.stdout)
+    print(json.dumps({"exit_code": code, "mode": "apply"}))
+    return code
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

